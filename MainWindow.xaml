                                            <MenuItem x:Name="SortByType" Header="Type" Click="Sort_Click" Tag="Type" IsCheckable="True"/>
                                            <MenuItem x:Name="SortBySize" Header="Size" Click="Sort_Click" Tag="Size" IsCheckable="True"/>
                                            <Separator/>
                                            <MenuItem x:Name="SortAsc" Header="Ascending" Click="SortDirection_Click" Tag="Asc" IsCheckable="True"/>
                                            <MenuItem x:Name="SortDesc" Header="Descending" Click="SortDirection_Click" Tag="Desc" IsCheckable="True"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
