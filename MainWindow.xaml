                                        <Border Width="1" Height="16" Background="{DynamicResource DividerBrush}" Margin="4,0"/>
                                        <Button Content="&#xE8C6;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Cut (Ctrl+X)" Click="Cut_Click"/>
                                        <Button Content="&#xE8C8;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Copy (Ctrl+C)" Click="Copy_Click"/>
                                        <Button Content="&#xE77F;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Paste (Ctrl+V)" Click="Paste_Click"/>
                                        <Button Content="&#xE8AC;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Rename (F2)" Click="Rename_Click"/>
                                        <Button Content="&#xE74D;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Delete (Del)" Click="Delete_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Block 8: Features Pill (Preview, Dual Pane, Hidden Files, AI Assistant) -->
                                <Border x:Name="ToolbarBlock_Features" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="7"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Height="34" Padding="2,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding TogglePreviewPaneCommand}" ToolTip="Toggle Preview Pane (Alt+P)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreviewPaneOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="&#xE749;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding ToggleDualPaneCommand}" ToolTip="Toggle Dual-Pane Mode (Alt+2)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDualPane}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding ToggleHiddenFilesCommand}" ToolTip="Toggle Hidden Files (Ctrl+H)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowHiddenFiles}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding ToggleAIAssistantCommand}" ToolTip="Assistant (Alt+A / Ctrl+Space)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAIAssistantOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Block 9: Workflow App Mode Switcher Pill -->
                                <Border x:Name="ToolbarBlock_AppModes" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="7"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Height="34" Padding="2,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetAppModeCommand}" CommandParameter="Explorer" ToolTip="Explorer Mode (Ctrl+1)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentAppMode}" Value="Explorer">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE748;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetAppModeCommand}" CommandParameter="DualCommander" ToolTip="Dual Commander (Ctrl+2)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentAppMode}" Value="DualCommander">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetAppModeCommand}" CommandParameter="MediaGallery" ToolTip="Media Gallery (Ctrl+3)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentAppMode}" Value="MediaGallery">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetAppModeCommand}" CommandParameter="DeveloperWorkspace" ToolTip="Developer Workspace (Ctrl+4)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentAppMode}" Value="DeveloperWorkspace">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetAppModeCommand}" CommandParameter="ZenFocus" ToolTip="Zen Focus Mode (Ctrl+5)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentAppMode}" Value="ZenFocus">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Block 10: File Details & Inspector Trigger -->
                                <Button x:Name="ToolbarBlock_Inspector" Content="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                        Width="34" Height="34" Margin="0,0,6,0" Click="Investigate_Click" ToolTip="File Details &amp; Inspector (Ctrl+I)"
                                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource AccentBrush}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Block 11: Terminal Console Launcher -->
                                <Button x:Name="ToolbarBlock_Terminal" Content="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                        Width="34" Height="34" Margin="0,0,6,0" Click="Terminal_Click" ToolTip="Open Terminal Console Here"
                                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Block 12: Selection Tools (Select All, Invert, Clear) -->
                                <Border x:Name="ToolbarBlock_Selection" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="7"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Height="34" Padding="2,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE8B3;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Select All (Ctrl+A)" Click="SelectAll_Click"/>
                                        <Button Content="&#xE8E6;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Invert Selection" Click="InvertSelection_Click"/>
                                        <Button Content="&#xE894;" Width="28" Height="28" Style="{StaticResource IconButton}" ToolTip="Clear Selection (Esc)" Click="ClearSelection_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Block 13: Settings Popup Trigger -->
                                <Button x:Name="ToolbarBlock_Settings" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                        Width="34" Height="34" Margin="0,0,6,0" Command="{Binding OpenSettingsCommand}" ToolTip="Settings &amp; Preferences"
                                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Block 14: Dynamic Overflow Button (More Tools) -->
                                <Button x:Name="ToolbarBlock_Overflow" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                        Width="34" Height="34" Margin="0,0,6,0" ToolTip="More Tools &amp; Options" Click="ToolbarOverflow_Click"
                                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ToolbarOverflowMenu">
                                            <MenuItem Header="More Toolbar Tools" IsEnabled="False" FontWeight="SemiBold"/>
                                            <Separator/>
                                            <MenuItem Header="Open Terminal Console" Click="Terminal_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="File Details &amp; Inspector" Click="Investigate_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Select All" Click="SelectAll_Click" InputGestureText="Ctrl+A">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Invert Selection" Click="InvertSelection_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8E6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Customize Toolbar..." Click="CustomizeToolbar_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- ROW B: UNIFIED FLUENT COMMAND BAR (Files App & Windows 11 Standard) -->
                            <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Padding="6,3" ContextMenu="{Binding ContextMenu, ElementName=DynamicToolbarGrid}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Section: + New ⌄, Clipboard Actions, Sort ⌄, View ⌄ -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Primary Split/Dropdown: + New ⌄ -->
                                        <Button Style="{DynamicResource CommandStripPrimaryButtonStyle}" Click="NewMenu_Click" ToolTip="Create New (Folder, Document, Script...)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                                <TextBlock Text="New" FontFamily="{DynamicResource UIFont}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="NewItemMenu">
                                                    <MenuItem Header="Folder" Click="NewDocument_Click" Tag="folder" FontWeight="SemiBold">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Text Document (.txt)" Click="NewDocument_Click" Tag="txt">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Markdown File (.md)" Click="NewDocument_Click" Tag="md">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="PowerShell Script (.ps1)" Click="NewDocument_Click" Tag="ps1">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Zip Archive (.zip)" Click="NewDocument_Click" Tag="zip">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xF012;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <!-- Divider -->
                                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="6,0"/>

                                        <!-- Windows 11 Fluent Icon Actions -->
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Cut_Click" ToolTip="Cut selection (Ctrl+X)">
                                            <TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Copy_Click" ToolTip="Copy selection (Ctrl+C)">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Paste_Click" ToolTip="Paste from clipboard (Ctrl+V)">
                                            <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Rename_Click" ToolTip="Rename selected item (F2)">
                                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Delete_Click" ToolTip="Delete selected items (Del)">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Foreground="#E06C75"/>
                                        </Button>

                                        <!-- Divider -->
                                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="6,0"/>

                                        <!-- Terminal & Properties -->
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="OpenTerminal_Click" ToolTip="Open Terminal in current directory">
                                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="Properties_Click" ToolTip="File Properties &amp; Metadata (Alt+Enter)">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>

                                        <!-- Divider -->
                                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="6,0"/>

                                        <!-- Sort ⌄ Dropdown -->
                                        <Button Style="{DynamicResource CommandStripButtonStyle}" Click="SortButton_Click" ToolTip="Sort options">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sort" FontFamily="{DynamicResource UIFont}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="CmdSortMenu" Opened="SortMenu_Opened">
                                                    <MenuItem Header="Name" Click="Sort_Click" Tag="Name" IsCheckable="True"/>
                                                    <MenuItem Header="Date Modified" Click="Sort_Click" Tag="DateModified" IsCheckable="True"/>
                                                    <MenuItem Header="Type" Click="Sort_Click" Tag="Type" IsCheckable="True"/>
                                                    <MenuItem Header="Size" Click="Sort_Click" Tag="Size" IsCheckable="True"/>
                                                    <Separator/>
                                                    <MenuItem Header="Ascending" Click="SortDirection_Click" Tag="Asc" IsCheckable="True"/>
                                                    <MenuItem Header="Descending" Click="SortDirection_Click" Tag="Desc" IsCheckable="True"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <!-- View ⌄ Dropdown -->
                                        <Button Style="{DynamicResource CommandStripButtonStyle}" Click="ViewButton_Click" ToolTip="View options">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE762;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="View" FontFamily="{DynamicResource UIFont}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="CmdViewMenu" Opened="ViewMenu_Opened">
                                                    <MenuItem Header="Details" Click="ViewMode_Click" Tag="Details">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE762;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grid / Tiles" Click="ViewMode_Click" Tag="Grid">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="List" Click="ViewMode_Click" Tag="List">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>

                                    <!-- Right Section: Files App Familiar Toggles (Preview, Dual, Copilot, Settings, Customize) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Preview Pane Toggle -->
                                        <Button Command="{Binding TogglePreviewPaneCommand}" ToolTip="Toggle Preview Pane (Alt+P)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CommandStripIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreviewPaneOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>

                                        <!-- Dual Pane Toggle -->
                                        <Button Command="{Binding ToggleDualPaneCommand}" ToolTip="Toggle Dual-Pane Mode (Alt+2)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CommandStripIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDualPane}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE749;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>

                                        <!-- Copilot / AI Assistant Toggle -->
                                        <Button Command="{Binding ToggleAIAssistantCommand}" ToolTip="Toggle Assistant (Alt+A / Ctrl+Space)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CommandStripIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAIAssistantOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>

                                        <!-- Divider -->
                                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="6,0"/>

                                        <!-- Settings Button -->
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings &amp; Preferences">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>

                                        <!-- Customize Toolbar Trigger -->
                                        <Button Style="{DynamicResource CommandStripIconButtonStyle}" Click="CustomizeToolbar_Click" ToolTip="Customize Toolbar &amp; Layout">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- EDGE-TO-EDGE FILE AREA CANVAS (Row 1) -->
                    <Border Grid.Row="1" BorderThickness="0"
                            CornerRadius="0" Margin="0" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource FileAreaBackgroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualPane}" Value="True">
                                                    <Setter Property="Width" Value="*"/>
                                                    <Setter Property="MinWidth" Value="240"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <!-- Dynamic Translucent Glass Wash Layer (Active when Custom Wallpaper is Enabled) -->
                            <Border Grid.ColumnSpan="3" Background="{DynamicResource WindowBackgroundBrush}"
                                    Opacity="{Binding FileAreaGlassOpacity, FallbackValue=0.25}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomBackground}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- PRIMARY FILE EXPLORER VIEWPORT (Column 0) -->
                            <Grid Grid.Column="0">
                                <!-- Loading Overlay -->
                                <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.8"
                                        Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        Panel.ZIndex="10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Reading directory contents..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Empty State Indicator -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding ActiveTab.IsFolderEmpty, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                            Panel.ZIndex="5">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PillBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="This folder is empty" FontFamily="{DynamicResource UIFontDisplay}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use the command bar above or right-click to create new files or folders."
                                               FontFamily="{DynamicResource UIFont}" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Details / Grid / List Dynamic ListView with Butter-Smooth Momentum Pixel Scrolling -->
                                <ListView x:Name="FileListView" ItemsSource="{Binding ActiveTab.Items}"
                                          Background="Transparent" BorderThickness="0" Margin="0"
                                          Loaded="FileListView_Loaded"
                                          SizeChanged="FileListView_SizeChanged"
                                          SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged"
                                          MouseDoubleClick="FileList_DoubleClick"
                                          MouseDown="FileList_MouseDown"
                                          GridViewColumnHeader.Click="ColumnHeader_Click"
                                          View="{StaticResource DetailsGridView}"
                                          ItemContainerStyle="{StaticResource DetailsListViewItemStyle}"
                                          ItemsPanel="{StaticResource DetailsItemsPanelTemplate}"
                                          controls:SmoothScrollHelper.IsEnabled="True"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True">
                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" Padding="8,14,8,6">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{DynamicResource UIFont}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="View">
                                                <MenuItem Header="Details" Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
                                                <MenuItem Header="Grid Icons" Command="{Binding SetViewModeCommand}" CommandParameter="Grid"/>
                                                <MenuItem Header="List" Command="{Binding SetViewModeCommand}" CommandParameter="List"/>
                                            </MenuItem>
                                            <MenuItem Header="Sort by" SubmenuOpened="SortSubmenu_Opened">
                                                <MenuItem x:Name="CtxSortByName" Header="Name" Click="Sort_Click" Tag="Name" IsCheckable="True"/>
                                                <MenuItem x:Name="CtxSortByDate" Header="Date Modified" Click="Sort_Click" Tag="DateModified" IsCheckable="True"/>
                                                <MenuItem x:Name="CtxSortByType" Header="Type" Click="Sort_Click" Tag="Type" IsCheckable="True"/>
                                                <MenuItem x:Name="CtxSortBySize" Header="Size" Click="Sort_Click" Tag="Size" IsCheckable="True"/>
                                                <Separator/>
                                                <MenuItem x:Name="CtxSortAsc" Header="Ascending" Click="SortDirection_Click" Tag="Asc" IsCheckable="True"/>
                                                <MenuItem x:Name="CtxSortDesc" Header="Descending" Click="SortDirection_Click" Tag="Desc" IsCheckable="True"/>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="New Folder" Click="NewFolder_Click" InputGestureText="Ctrl+Shift+N">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource FolderColorBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="New Text Document" Click="NewFile_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DocColorBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Cut" Click="Cut_Click" InputGestureText="Ctrl+X">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy" Click="Copy_Click" InputGestureText="Ctrl+C">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Paste" Click="Paste_Click" InputGestureText="Ctrl+V">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Select All" Click="SelectAll_Click" InputGestureText="Ctrl+A">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Show Hidden Files" Click="ToggleHiddenFiles_Click" InputGestureText="Ctrl+H">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Toggle Preview Pane" Click="TogglePreviewPane_Click" InputGestureText="Alt+P">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Open in Terminal" Click="OpenTerminal_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Refresh" Click="Refresh_Click" InputGestureText="F5">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Investigate Folder..." Click="Investigate_Click" InputGestureText="Ctrl+I">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Properties &amp; Meta..." Click="Properties_Click" InputGestureText="Alt+Enter">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                </ListView>
                            </Grid>

                            <!-- DUAL PANE SPLITTER -->
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                          Background="{DynamicResource DividerBrush}" ShowsPreview="False"
                                          Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                            <!-- SECONDARY FILE EXPLORER VIEWPORT (Column 2 - Hardware-Accelerated Smooth Slide Transition) -->
                            <Grid Grid.Column="2" Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="35" To="0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.0" To="1.0" Duration="0:0:0.16"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Secondary Pane Header Bar -->
                                <Border Grid.Row="0" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE749;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SecondaryTab.Title, FallbackValue='Secondary Pane'}" FontFamily="{DynamicResource UIFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SecondaryTab.TotalItemCount, StringFormat=' ({0} items)', FallbackValue=''}" FontFamily="{DynamicResource UIFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26" Command="{Binding SwapPanesCommand}" ToolTip="Swap Panes (Ctrl+U)">
                                                <TextBlock Text="&#xE748;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26" Command="{Binding SecondaryTab.RefreshCommand}" ToolTip="Refresh (F5)" Margin="4,0,0,0">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Secondary Loading Overlay -->
                                <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.8"
                                        Visibility="{Binding SecondaryTab.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        Panel.ZIndex="10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Reading directory..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Secondary FileListView -->
                                <ListView x:Name="SecondaryFileListView" Grid.Row="1" ItemsSource="{Binding SecondaryTab.Items}"
                                          Background="Transparent" BorderThickness="0" Margin="0"
                                          Loaded="FileListView_Loaded"
                                          SizeChanged="FileListView_SizeChanged"
                                          SelectionMode="Extended"
                                          MouseDoubleClick="SecondaryFileList_DoubleClick"
                                          MouseDown="SecondaryFileList_MouseDown"
                                          View="{StaticResource DetailsGridView}"
                                          ItemContainerStyle="{StaticResource DetailsListViewItemStyle}"
                                          ItemsPanel="{StaticResource DetailsItemsPanelTemplate}"
                                          controls:SmoothScrollHelper.IsEnabled="True"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True">
                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" Padding="8,14,8,6">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{DynamicResource UIFont}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─── PREVIEW PANE SPLITTER ────────────────── -->
                <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource DividerBrush}" ShowsPreview="False"
                              Visibility="{Binding IsPreviewPaneOpen, Converter={StaticResource BoolToVis}}"/>

                <!-- ─── PREVIEW PANE CARD (Hardware-Accelerated Smooth Slide Transition) ─── -->
                <Border Grid.Column="3" Width="{Binding Settings.PreviewPaneWidth, FallbackValue=390}"
                        MinWidth="300" MaxWidth="750"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsPreviewPaneOpen, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource FileAreaBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TranslucentCardBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="35" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <controls:PreviewPaneControl DataContext="{Binding PreviewPane}"
                                                CloseRequested="PreviewPane_CloseRequested"/>
                </Border>

                <!-- ─── AI COPILOT SPLITTER ──────────────────── -->
                <GridSplitter Grid.Column="4" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{DynamicResource DividerBrush}" ShowsPreview="False"
                              Visibility="{Binding IsAIAssistantOpen, Converter={StaticResource BoolToVis}}"/>

                <!-- ─── AI COPILOT CARD (Hardware-Accelerated Smooth Slide Transition) ───── -->
                <Border Grid.Column="5" Width="{Binding AIAssistant.PaneWidth, Mode=TwoWay, FallbackValue=420}"
                        MinWidth="320" MaxWidth="850"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsAIAssistantOpen, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource FileAreaBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TranslucentCardBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="35" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <controls:AIAssistantControl x:Name="AICopilotControl" DataContext="{Binding AIAssistant}"
                                                 CloseRequested="AIAssistant_CloseRequested"/>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- ROW 2: DOCKED STATUS BAR                        -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,0" Height="32"
                    Visibility="{Binding Settings.ShowStatusBar, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource StatusBarBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TranslucentStatusBarBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Center">
                    <!-- Left: Item counts & selection metadata -->
                    <TextBlock Text="{Binding StatusText}" FontFamily="{DynamicResource UIFont}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <!-- Right: Local AI Indicator & Interactive View Mode Switcher -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Local Assistant Status Badge (Interactive) -->
                        <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="8,3" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonDown="LocalAIStatus_Click"
                                ToolTip="Click to open Assistant (Alt+A)">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Assistant: Ready" FontFamily="{DynamicResource UIFont}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick View Mode Switchers (Files App & Windows 11 style) -->
                        <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="2,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE762;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                        Width="24" Height="22" Command="{Binding SetViewModeCommand}" CommandParameter="Details"
                                        ToolTip="Details (Ctrl+Shift+6)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="Details">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                        Width="24" Height="22" Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                        ToolTip="Grid / Tiles (Ctrl+Shift+2)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="Grid">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                        Width="24" Height="22" Command="{Binding SetViewModeCommand}" CommandParameter="List"
                                        ToolTip="List (Ctrl+Shift+5)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="List">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- INLINE MODAL OVERLAY (Rename & Custom Input)    -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid x:Name="InputModalOverlay" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="3">
                <Border Background="#99000000" MouseLeftButtonDown="InputModal_BackdropClick"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="400"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="InputModalTitle" Text="Rename Item" FontFamily="{DynamicResource UIFontDisplay}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <TextBox x:Name="InputModalTextBox" FontFamily="{DynamicResource UIFont}" FontSize="13.5"
                                 Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                 BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 Padding="12,9" Margin="0,0,0,18" KeyDown="InputModalTextBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" FontFamily="{DynamicResource UIFont}" FontSize="13"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand" Click="InputModalCancel_Click"/>
                            <Button x:Name="InputModalConfirmBtn" Content="Apply" FontFamily="{DynamicResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                    Style="{DynamicResource PrimaryButton}" Padding="20,8" Cursor="Hand" Click="InputModalConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- End Inline Modal Overlay -->
        </Grid>
    </Border>

</Window>
