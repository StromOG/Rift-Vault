<Window x:Class="RiftVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:RiftVault.ViewModels"
        xmlns:converters="clr-namespace:RiftVault.UI.Converters"
        xmlns:controls="clr-namespace:RiftVault.UI.Controls"
        mc:Ignorable="d"
        Title="Rift Vault" Height="800" Width="1360"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UIFont}"
        FontSize="13.5"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowActivated="True" ShowInTaskbar="True"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="3"
                      GlassFrameThickness="0"
                      CornerRadius="10"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTEXT MENUS (Defined at top to avoid UnsetValue)     -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Tab Context Menu -->
        <ContextMenu x:Key="TabContextMenu" x:Shared="false">
            <MenuItem Header="New Tab" Click="NewTabFromMenu_Click" InputGestureText="Ctrl+T">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate Tab" Click="DuplicateTabFromMenu_Click" InputGestureText="Ctrl+Shift+D">
                <MenuItem.Icon>
                    <TextBlock Text="&#xF413;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pin / Unpin Tab" Click="TogglePinTabFromMenu_Click" InputGestureText="Ctrl+P">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Close Tab" Click="CloseTabFromMenu_Click" InputGestureText="Ctrl+W">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource ErrorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Close Other Tabs" Click="CloseOtherTabsFromMenu_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Close Tabs to the Right" Click="CloseTabsToRightFromMenu_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Reopen Closed Tab" Click="ReopenClosedTabFromMenu_Click" InputGestureText="Ctrl+Shift+T">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy Tab Path" Click="CopyTabPathFromMenu_Click" InputGestureText="Ctrl+Shift+C">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Windows 11 Context Menu Top Bar Quick Action Button Style -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern File / Folder Context Menu (Windows 11 Layout with Rift Vault Innovations) -->
        <ContextMenu x:Key="FileItemContextMenu" MinWidth="345">
            <!-- 1. Top Row: Windows 11 Style Horizontal Quick Action Strip (Cut, Copy, Rename, Share, Delete) -->
            <MenuItem Height="56" Focusable="False" StaysOpenOnClick="False" Margin="3,4,3,4" Padding="0">
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="3,3" Margin="2,2,2,2" SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cut -->
                                <Button Grid.Column="0" Click="QuickCut_Click" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Cut (Ctrl+X)">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Cut" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Grid.Column="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,7"/>

                                <!-- Copy -->
                                <Button Grid.Column="2" Click="QuickCopy_Click" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Copy (Ctrl+C)">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Grid.Column="3" Fill="{DynamicResource CardBorderBrush}" Margin="0,7"/>

                                <!-- Rename -->
                                <Button Grid.Column="4" Click="QuickRename_Click" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Rename (F2)">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Rename" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Grid.Column="5" Fill="{DynamicResource CardBorderBrush}" Margin="0,7"/>

                                <!-- Share -->
                                <Button Grid.Column="6" Click="QuickShare_Click" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Share">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Share" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Grid.Column="7" Fill="{DynamicResource CardBorderBrush}" Margin="0,7"/>

                                <!-- Delete -->
                                <Button Grid.Column="8" Click="QuickDelete_Click" Style="{DynamicResource QuickActionButtonStyle}" ToolTip="Delete (Del)">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Delete" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>

            <!-- 2. Primary Navigation & Opening -->
            <MenuItem Header="Open" Click="OpenItem_Click" FontWeight="SemiBold" InputGestureText="Enter">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <!-- Folder Specific Navigation (Strictly hidden for non-directories) -->
            <MenuItem Header="Open in New Tab" Click="OpenInNewTab_Click" InputGestureText="Ctrl+T"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource FolderColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in New Window" Click="OpenInNewWindow_Click" InputGestureText="Ctrl+N"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE78B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource FolderColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in Terminal" Click="OpenTerminal_Click" InputGestureText="Ctrl+Shift+T"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 3. Image-Specific Manipulation Tools (Strictly hidden for folders, videos, code, etc.) -->
            <MenuItem Header="Set as desktop background" Click="SetDesktopBackground_Click"
                      Visibility="{Binding CanSetAsWallpaper, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ImageColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rotate right 90°" Click="RotateRight_Click"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ImageColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rotate left 90°" Click="RotateLeft_Click"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ImageColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Edit in Paint" Click="OpenWithPaint_Click"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ImageColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 4. Archive-Specific Extraction Tools (Strictly hidden for non-archives) -->
            <MenuItem Header="Extract All..." Click="ExtractZip_Click"
                      Visibility="{Binding IsArchive, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ArchiveColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Extract to Subfolder" Click="ExtractToFolder_Click"
                      Visibility="{Binding IsArchive, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xF012;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ArchiveColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 5. Code & Text Editing Tools (Strictly for code/text documents) -->
            <MenuItem Header="Edit with Visual Studio Code" Click="OpenWithVSCode_Click"
                      Visibility="{Binding IsCodeOrText, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource CodeColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Edit in Notepad" Click="OpenWithNotepad_Click"
                      Visibility="{Binding IsCodeOrText, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 6. Executable Specific Tools (Strictly for binaries and scripts) -->
            <MenuItem Header="Run as administrator" Click="RunAsAdmin_Click" InputGestureText="Ctrl+Shift+Enter"
                      Visibility="{Binding IsExecutable, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ExecColorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 7. Folder Quick Access & Management (Strictly for folders) -->
            <MenuItem Header="Add to Favorites" Click="PinToQuickAccess_Click"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <!-- 8. Open with... Submenu (Files only) -->
            <MenuItem Header="Open with..." Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </MenuItem.Icon>
                <MenuItem Header="Windows Notepad" Click="OpenWithNotepad_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Visual Studio Code" Click="OpenWithVSCode_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource CodeColorBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paint" Click="OpenWithPaint_Click" Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ImageColorBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Choose another app..." Click="OpenWithDialog_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE7B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 9. Smart Tools Submenu -->
            <MenuItem Header="Smart Tools">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
                <MenuItem Header="Ask Assistant" Click="AskAI_Click" InputGestureText="Alt+A">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Summarize Item" Click="AISummarize_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Inspect Details &amp; Forensics" Click="Investigate_Click" InputGestureText="Ctrl+I">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Organize Files into Folders" Click="SmartOrganize_Click"
                          Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 10. More Tools (Pin to Shelf, Encrypt, Integrity Checksums) -->
            <MenuItem Header="More Tools">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                </MenuItem.Icon>
                <MenuItem Header="Pin to Shelf (Quick Access)" Click="TeleportOrShare_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Encrypt File (Password Protect)" Click="SecureVault_Click"
                          Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Check File Integrity (Checksums)" Click="ComputeChecksum_Click"
                          Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- 11. Compression & Archives -->
            <MenuItem Header="Compress to...">
                <MenuItem.Icon>
                    <TextBlock Text="&#xF012;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ArchiveColorBrush}"/>
                </MenuItem.Icon>
                <MenuItem Header="Compress to ZIP" Click="CompressToZip_Click"/>
                <MenuItem Header="Compress to 7z (Ultra)" Click="CompressTo7z_Click"/>
            </MenuItem>

            <Separator/>

            <!-- 12. Copy Path -->
            <MenuItem Header="Copy as path" Click="CopyPath_Click" InputGestureText="Ctrl+Shift+C">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextDimBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- 13. Properties & Forensics -->
            <MenuItem Header="Properties" Click="Properties_Click" InputGestureText="Alt+Enter">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <!-- 14. Show More Options (Classic Windows 11 Shell) -->
            <MenuItem Header="Show more options" Click="ShowMoreOptions_Click" InputGestureText="Shift+F10">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- VIEW MODE TEMPLATES & STYLES                            -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Fixed Viewport Non-Scrollable Address Bar TextBox Style -->
        <Style x:Key="AddressBarTextBoxStyle" TargetType="TextBox">
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ScrollViewer.PanningMode" Value="None"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True" VerticalAlignment="Center">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="0"
                                          Padding="0,1,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark GridViewColumnHeader Style (Eliminates Aero2 White Gloss Header Strip) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UIFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Details GridView with Enriched File/Folder Presentation -->
        <GridView x:Key="DetailsGridView" x:Shared="False">
            <!-- Name Column -->
            <GridViewColumn Header="Name" Width="460">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHiddenItem}" Value="True">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Visual Icon / Shell Thumbnail -->
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{Binding ItemColorBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource InverseBoolToVis}}"/>
                                <Border Width="24" Height="24" CornerRadius="5" ClipToBounds="True"
                                        Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>

                            <!-- Name & Badge Presentation -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- Base Name (SemiBold High-Contrast) -->
                                <TextBlock Text="{Binding BaseName}"
                                           FontFamily="{DynamicResource UIFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="1200"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Model.Name}"/>

                                <!-- Distinctive Type Badge Pill -->
                                <Border Background="{Binding BadgeBackgroundBrush}"
                                        BorderBrush="{Binding BadgeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding BadgeText}"
                                               FontFamily="{DynamicResource UIFont}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding ItemColorBrush}"/>
                                </Border>

                                <!-- Hidden File Icon Marker -->
                                <TextBlock Text="&#xE7B3;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           ToolTip="Hidden File/Folder"
                                           Visibility="{Binding IsHiddenItem, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <!-- Date Modified Column -->
            <GridViewColumn Header="Date Modified" Width="170">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,0" ToolTip="{Binding Model.DateModified, StringFormat='{}{0:dd-MM-yyyy HH:mm:ss}'}">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding DisplayDate}" FontFamily="{DynamicResource UIFont}" FontSize="13.5"
                                       FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <!-- Type Column -->
            <GridViewColumn Header="Type" Width="190">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,0">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ItemColorBrush}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TypeDescription}" FontFamily="{DynamicResource UIFont}" FontSize="13.5"
                                       FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

            <!-- Size Column -->
            <GridViewColumn Header="Size" Width="110">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplaySize}" FontFamily="{DynamicResource UIFont}" FontSize="13.5"
                                   FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0" TextAlignment="Right"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>

        <!-- Grid / Tile View Item Template -->
        <DataTemplate x:Key="GridItemTemplate">
            <Border Background="{DynamicResource PillBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Width="136" Height="156" Margin="6" Padding="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHiddenItem}" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Icon / Shell Thumbnail with Corner Micro-Badge -->
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Glyph Fallback -->
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="42"
                                   Foreground="{Binding ItemColorBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- High-DPI Thumbnail -->
                        <Border Width="62" Height="62" CornerRadius="8" ClipToBounds="True"
                                Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Micro-Badge Pill floating at top-right -->
                        <Border Background="{Binding BadgeBackgroundBrush}"
                                BorderBrush="{Binding BadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4" Padding="4,1.5"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-6,-12,0"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BadgeText}"
                                       FontFamily="{DynamicResource UIFont}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding ItemColorBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Naming & Detail Section -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,6,0,0">
                        <!-- Base Name (Double-line wrap with ellipsis) -->
                        <TextBlock Text="{Binding BaseName}"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxHeight="36" TextWrapping="WrapWithOverflow"
                                   ToolTip="{Binding Model.Name}"/>

                        <!-- Secondary Detail (Folder type or Size · Ext) -->
                        <TextBlock Text="{Binding SecondaryDetail}"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- List View Item Template -->
        <DataTemplate x:Key="ListItemTemplate">
            <Grid Margin="6,3" Height="34">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHiddenItem}" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Foreground="{Binding ItemColorBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BaseName}" FontFamily="{DynamicResource UIFont}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding Model.Name}"/>
                    <Border Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding BadgeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ItemColorBrush}"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontFamily="{DynamicResource UIFont}"
                           FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="{Binding TypeDescription}" FontFamily="{DynamicResource UIFont}"
                           FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Panel Templates -->
        <ItemsPanelTemplate x:Key="DetailsItemsPanelTemplate">
            <VirtualizingStackPanel Orientation="Vertical" IsItemsHost="True" VirtualizingPanel.ScrollUnit="Pixel"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="GridItemsPanelTemplate">
            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListItemsPanelTemplate">
            <VirtualizingStackPanel Orientation="Vertical" IsItemsHost="True" VirtualizingPanel.ScrollUnit="Pixel"/>
        </ItemsPanelTemplate>

        <!-- Date separators are deliberately quiet: they provide orientation in
             content-heavy folders without turning This PC into a dashboard. -->
        <GroupStyle x:Key="DateGroupStyle" x:Shared="False">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource FileAreaBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,14,10,7"
                            Margin="0,8,0,0">
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Details ItemContainerStyle (Custom Template with Files App signature left-edge accent indicator) -->
        <Style x:Key="DetailsListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="{DynamicResource FileItemPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource FileItemMargin}"/>
            <Setter Property="MinHeight" Value="{DynamicResource FileItemMinHeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{DynamicResource FileItemContextMenu}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListViewItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Files App signature left-edge accent indicator bar -->
                                <Border x:Name="selIndicator" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="5,0,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter TargetName="selIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid ItemContainerStyle -->
        <Style x:Key="GridListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{DynamicResource FileItemContextMenu}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListViewItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" CornerRadius="12" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List ItemContainerStyle (Custom Template) -->
        <Style x:Key="ListListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="{DynamicResource FileItemPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource FileItemMargin}"/>
            <Setter Property="MinHeight" Value="{DynamicResource FileItemMinHeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{DynamicResource FileItemContextMenu}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListViewItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="1.0" ScaleY="1.0"/>
                <TranslateTransform x:Name="WindowTranslate" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>     <!-- Row 0: Top Bar & Integrated Tab Strip -->
                <RowDefinition Height="*"/>      <!-- Row 1: Main Workspace (Docked Sidebar + Content Area) -->
                <RowDefinition Height="Auto"/>   <!-- Row 2: Docked Status Bar -->
            </Grid.RowDefinitions>

            <!-- Base Canvas Background Layer (visible when no wallpaper or under transparent parts) -->
            <Border Grid.RowSpan="3" Background="{DynamicResource WindowBackgroundBrush}"/>

            <!-- Custom Wallpaper Background Layer -->
            <Image x:Name="WallpaperImage" Grid.RowSpan="3"
                   Source="{Binding CustomBackgroundPath}"
                   Opacity="{Binding BackgroundOpacity}"
                   Stretch="{Binding BackgroundStretch}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomBackgroundPath}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CustomBackgroundPath}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
                <Image.Effect>
                    <BlurEffect Radius="{Binding BackgroundBlur}"/>
                </Image.Effect>
            </Image>

            <!-- Dimmer / Acrylic Contrast Tint Overlay over Custom Wallpaper -->
            <Border Grid.RowSpan="3" Background="#000000" Opacity="{Binding BackgroundDimmer, FallbackValue=0.30}" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomBackground}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- ROW 0: TOP BAR & INTEGRATED TAB STRIP           -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TranslucentHeaderBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- App Brand -->
                        <ColumnDefinition Width="*"/>    <!-- Tab Strip -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Badge & Elevation Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="18" Height="18" Margin="0,0,8,0" CornerRadius="5"
                                Background="{DynamicResource AccentBrush}" Opacity="0.12" VerticalAlignment="Center">
                            <Grid>
                                <Path Data="M9,2 L15,6 L15,12 L9,16 L3,12 L3,6 Z"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Path Data="M6,7 H10.5 C12.7,7 14,8.1 14,9.8 C14,11.5 12.7,12.6 10.5,12.6 H6 V7 Z"
                                      Fill="{DynamicResource AccentBrush}" Opacity="0.9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Rift Vault" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <!-- Admin Elevation Pill Badge (when running elevated) -->
                        <Border Background="#256B9AC4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Running with Full Administrator Privileges"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="ADMIN" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Integrated Tab Strip -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="tabPill" Margin="3,2" Padding="12,5,8,5" CornerRadius="7" Cursor="Hand"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                MouseLeftButtonDown="Tab_Click" MouseUp="Tab_MouseUp"
                                                ContextMenu="{DynamicResource TabContextMenu}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Pin Glyph -->
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                                           Foreground="{DynamicResource FolderColorBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                <!-- Close Button (Hidden if pinned) -->
                                                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5"
                                                        Width="20" Height="20" Margin="8,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextDimBrush}"
                                                        Cursor="Hand" Click="CloseTab_Click" Tag="{Binding}"
                                                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="closeBg" Background="Transparent" CornerRadius="10">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="closeBg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="tabPill" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                                <Setter TargetName="tabPill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabPill" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Tab Button -->
                            <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                    Width="28" Height="28" Margin="4,0,8,0" Command="{Binding AddNewTabCommand}"
                                    ToolTip="New Tab (Ctrl+T)" Cursor="Hand" Background="{DynamicResource PillBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource TextSecondaryBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Window Caption Controls (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"/>
                        <Button x:Name="MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaxRestore_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- ROW 1: MAIN WORKSPACE (DOCKED SIDEBAR + WORK)   -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360"/> <!-- Column 0: Docked Navigation Sidebar -->
                    <ColumnDefinition Width="*"/>                                  <!-- Column 1: Main Content (Toolbar + File Canvas) -->
                    <ColumnDefinition Width="Auto"/>                               <!-- Column 2: Preview Splitter -->
                    <ColumnDefinition Width="Auto"/>                               <!-- Column 3: Preview Pane Card -->
                    <ColumnDefinition Width="Auto"/>                               <!-- Column 4: AI Splitter -->
                    <ColumnDefinition Width="Auto"/>                               <!-- Column 5: AI Copilot Card -->
                </Grid.ColumnDefinitions>

                <!-- ─── DOCKED NAVIGATION SIDEBAR ──────────────── -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0"
                        Padding="0,6,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TranslucentSidebarBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" controls:SmoothScrollHelper.IsEnabled="True">
                        <StackPanel Margin="6,0,6,12">
                            <!-- Quick Access Section Header -->
                            <TextBlock Text="QUICK ACCESS" FontFamily="{DynamicResource UIFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,12,0,8"/>

                            <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="QuickAccess_Click" Tag="{Binding Path}" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                Padding="0" Margin="0,1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="8,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Files App style 3px left accent indicator -->
                                                            <Rectangle x:Name="accentIndicator" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                                                       Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                                                       Margin="0,0,10,0" Visibility="Hidden"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource QuickAccessIconStyle}" FontSize="15" Margin="0,0,11,0"/>
                                                                <TextBlock x:Name="nameText" Text="{Binding Name}" FontFamily="{DynamicResource UIFont}" FontSize="13.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                            <Setter TargetName="accentIndicator" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                            <Setter TargetName="accentIndicator" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="nameText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="nameText" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Hairline Divider -->
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,12"/>

                            <!-- Drives / This PC Section Header -->
                            <TextBlock Text="THIS PC &amp; STORAGE" FontFamily="{DynamicResource UIFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,6,0,8"/>

                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Drive_Click" Tag="{Binding Path}" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                Padding="0" Margin="0,2.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="7" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle x:Name="accentIndicator" Width="3" Height="24" RadiusX="1.5" RadiusY="1.5"
                                                                       Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                                                       Margin="0,0,8,0" Visibility="Hidden"/>
                                                            <StackPanel Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="driveLabel" Text="{Binding Label}" FontFamily="{DynamicResource UIFont}" FontSize="13.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding UsageText}" FontFamily="{DynamicResource UIFont}" FontSize="12.5" FontWeight="Medium"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <!-- Modern thin progress bar -->
                                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}"
                                                                             Height="5" Margin="28,7,4,0" BorderThickness="0"
                                                                             Background="{DynamicResource PillBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                            <Setter TargetName="accentIndicator" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                            <Setter TargetName="accentIndicator" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="driveLabel" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ─── MAIN CONTENT AREA (TOOLBAR + ELEVATED FILES CANVAS) ─── -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Unified Command Header & Actions Strip -->
                        <RowDefinition Height="*"/>    <!-- Row 1: Elevated File Area Canvas -->
                    </Grid.RowDefinitions>

                    <!-- UNIFIED COMMAND HEADER (Row 0) -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TranslucentToolbarBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- ROW A: DYNAMIC MODULAR TOOLBAR (User-Customizable & Auto-Expanding Address Bar) -->
                            <Grid x:Name="DynamicToolbarGrid" Margin="0,0,0,6" Background="Transparent" ContextMenuOpening="DynamicToolbarGrid_ContextMenuOpening">
                                <Grid.ContextMenu>
                                    <ContextMenu x:Name="ToolbarContextMenu">
                                        <MenuItem Header="Customize Toolbar..." Click="CustomizeToolbar_Click" FontWeight="SemiBold">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reset Toolbar to Default" Click="ResetToolbar_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="CtxToggle_nav" Header="Navigation Controls" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="nav"/>
                                        <MenuItem x:Name="CtxToggle_address" Header="Address Bar (Flexible)" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="address"/>
                                        <MenuItem x:Name="CtxToggle_search" Header="Search Omnibar" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="search"/>
                                        <MenuItem x:Name="CtxToggle_viewmode" Header="View Modes" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="viewmode"/>
                                        <MenuItem x:Name="CtxToggle_sort" Header="Sort Options" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="sort"/>
                                        <MenuItem x:Name="CtxToggle_customize" Header="Customize Toolbar Button" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="customize"/>
                                        <Separator/>
                                        <MenuItem x:Name="CtxToggle_actionstrip" Header="Inline Command Actions" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="actionstrip"/>
                                        <MenuItem x:Name="CtxToggle_features" Header="Quick Features (Preview, Dual, Hidden, AI)" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="features"/>
                                        <MenuItem x:Name="CtxToggle_appmodes" Header="Workflow Modes (Explorer, Dual, Media, Dev, Zen)" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="appmodes"/>
                                        <MenuItem x:Name="CtxToggle_inspector" Header="File Inspector &amp; Forensics" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="inspector"/>
                                        <MenuItem x:Name="CtxToggle_terminal" Header="Terminal Console" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="terminal"/>
                                        <MenuItem x:Name="CtxToggle_selection" Header="Selection Tools" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="selection"/>
                                        <MenuItem x:Name="CtxToggle_settings" Header="Settings Button" IsCheckable="True" Click="ToolbarQuickToggle_Click" Tag="settings"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>

                            <!-- TOOLBAR BLOCKS POOL (Instantiated blocks dynamically mounted into DynamicToolbarGrid based on user layout) -->
                            <Grid x:Name="ToolbarBlocksPool" Visibility="Collapsed">
                                <!-- Block 1: Navigation Cluster -->
                                <Border x:Name="ToolbarBlock_Nav" Background="{DynamicResource PillBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="2,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Style="{DynamicResource IconButton}"
                                                Width="32" Height="32" Command="{Binding ActiveTab.GoBackCommand}" ToolTip="Back (Alt+Left)"/>
                                        <Button Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Style="{DynamicResource IconButton}"
                                                Width="32" Height="32" Command="{Binding ActiveTab.GoForwardCommand}" ToolTip="Forward (Alt+Right)"/>
                                        <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Style="{DynamicResource IconButton}"
                                                Width="32" Height="32" Command="{Binding ActiveTab.GoUpCommand}" ToolTip="Up to Parent Directory (Alt+Up)"/>
                                        <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Style="{DynamicResource IconButton}"
                                                Width="32" Height="32" Command="{Binding ActiveTab.RefreshCommand}" ToolTip="Refresh (F5)"/>
                                    </StackPanel>
                                </Border>

                                <!-- Block 2: Smart Address & Command Bar (Flexible star-expanding) -->
                                <Grid x:Name="ToolbarBlock_Address" Margin="0,0,6,0">
                                    <Border x:Name="AddressBarContainer" Background="{DynamicResource AddressBarBackgroundBrush}" CornerRadius="7"
                                            BorderBrush="{DynamicResource AddressBarBorderBrush}" BorderThickness="1"
                                            Height="34" Padding="6,0" VerticalAlignment="Center" Cursor="IBeam"
                                            PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown">
                                        <Grid>
                                            <!-- Mode 1: Interactive Breadcrumbs Display -->
                                            <Grid x:Name="BreadcrumbView" Visibility="Visible" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                              VerticalAlignment="Center" Background="Transparent"
                                                              PreviewMouseLeftButtonDown="BreadcrumbScrollViewer_PreviewMouseLeftButtonDown">
                                                    <ItemsControl ItemsSource="{Binding ActiveTab.Breadcrumbs}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="{Binding Name}" Tag="{Binding FullPath}"
                                                                            FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                            Padding="6,3" Click="Breadcrumb_Click">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="crumbBg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="crumbBg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <!-- Quick Access / Storage Drive Icon Indicator -->
                                                <Button Grid.Column="1" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                        Style="{DynamicResource IconButton}" Width="24" Height="24" Margin="2,0,0,0"
                                                        ToolTip="Address Actions &amp; Copy Path" Click="AddressBarMoreActions_Click"/>
                                            </Grid>

                                            <!-- Mode 2: Direct-Type Editable Path TextBox -->
                                            <Grid x:Name="AddressEditView" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="&#xE8DA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>

                                                <TextBox Grid.Column="1" x:Name="AddressTextBox"
                                                         FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         KeyDown="AddressTextBox_KeyDown"
                                                         LostFocus="AddressTextBox_LostFocus"/>

                                                <TextBlock Grid.Column="1" Text="Type path, URL, or shell: shortcut and press Enter..."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,0,0"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=AddressTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Grid.Column="2" Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                        Style="{DynamicResource IconButton}" Width="24" Height="24"
                                                        ToolTip="Recent paths" Click="AddressHistoryDropdown_Click"/>

                                                <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                        Style="{DynamicResource IconButton}" Width="24" Height="24"
                                                        ToolTip="Cancel (Esc)" Click="CancelAddressEdit_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Address History Dropdown Popup -->
                                    <Popup x:Name="AddressHistoryPopup" PlacementTarget="{Binding ElementName=AddressBarContainer}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide"
                                           Closed="AddressHistoryPopup_Closed">
                                        <Border Width="{Binding ActualWidth, ElementName=AddressBarContainer}"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="0,0,8,8" Padding="4,6" Margin="0,2,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
                                            </Border.Effect>
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="AddressHistoryItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Click="AddressHistoryItem_Click" Tag="{Binding FullPath}"
                                                                    HorizontalContentAlignment="Left" Background="Transparent"
                                                                    BorderThickness="0" Padding="10,6" Margin="2,1" Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="22"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- Block 3: Search Omnibar with Clear Button -->
                                <Border x:Name="ToolbarBlock_Search" Background="{DynamicResource AddressBarBackgroundBrush}" CornerRadius="7"
                                        BorderBrush="{DynamicResource AddressBarBorderBrush}" BorderThickness="1"
                                        Height="34" Width="200" Margin="0,0,6,0">
                                    <Grid>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBox x:Name="OmniSearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="28,0,24,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="Search files &amp; folders..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="30,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=OmniSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button x:Name="OmniSearchClearButton" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                ToolTip="Clear search" Click="ClearSearch_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=OmniSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Block 4: View Mode Switcher -->
                                <Border x:Name="ToolbarBlock_ViewMode" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="7"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Height="34" Padding="2,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE762;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetViewModeCommand}" CommandParameter="Details" ToolTip="Details View (Ctrl+Shift+6)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="Details">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetViewModeCommand}" CommandParameter="Grid" ToolTip="Grid Icons (Ctrl+Shift+2)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="Grid">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                Width="28" Height="28"
                                                Command="{Binding SetViewModeCommand}" CommandParameter="List" ToolTip="List View (Ctrl+Shift+5)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab.CurrentViewMode}" Value="List">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Block 5: Sort Button with Dropdown Menu -->
                                <Button x:Name="ToolbarBlock_Sort" Content="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                        Width="30" Height="30" Margin="0,0,6,0" ToolTip="Sort by..." Click="SortButton_Click"
                                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="SortMenu" Opened="SortMenu_Opened">
                                            <MenuItem x:Name="SortByName" Header="Name" Click="Sort_Click" Tag="Name" IsCheckable="True"/>
