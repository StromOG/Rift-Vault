<UserControl x:Class="RiftVault.UI.Controls.AIAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:RiftVault.ViewModels"
             xmlns:controls="clr-namespace:RiftVault.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="420">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Option Chip Style -->
        <Style x:Key="NextOptionChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Tools -->
                <RowDefinition Height="*"/>    <!-- Row 1: Content (Chat / History) -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- ROW 0: TOP HEADER                                -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Neural Icon -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                            Background="#18818CF8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Margin="0,0,8,0">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Engine Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rift AI Copilot" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#1A34D399" BorderBrush="#34D399" BorderThickness="0.5">
                                <TextBlock Text="{Binding SelectedProvider}" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveEngineStatus}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Header Tools: Width Presets, New Chat, History, Export, Settings, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Width Quick Toggle: Compact 340, Standard 440, Wide 620 -->
                        <Button Content="S" ToolTip="Compact Width (340px)" Style="{DynamicResource IconButton}" Width="22" Height="22" Margin="0,0,2,0"
                                Command="{Binding SetPaneWidthCommand}" CommandParameter="340"
                                FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold" FontSize="10"/>
                        <Button Content="M" ToolTip="Standard Width (440px)" Style="{DynamicResource IconButton}" Width="22" Height="22" Margin="0,0,2,0"
                                Command="{Binding SetPaneWidthCommand}" CommandParameter="440"
                                FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold" FontSize="10"/>
                        <Button Content="L" ToolTip="Wide Width (620px)" Style="{DynamicResource IconButton}" Width="22" Height="22" Margin="0,0,6,0"
                                Command="{Binding SetPaneWidthCommand}" CommandParameter="620"
                                FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold" FontSize="10"/>

                        <!-- Start New Chat -->
                        <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                                Command="{Binding StartNewSessionCommand}" ToolTip="New Conversation"/>

                        <!-- Toggle History View -->
                        <Button Content="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                                Command="{Binding ToggleHistoryCommand}" ToolTip="Chat History &amp; Archives"/>

                        <!-- Export Chat to Markdown -->
                        <Button Content="&#xEDE1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                                Command="{Binding ExportChatCommand}" ToolTip="Export Conversation to Markdown"/>

                        <!-- AI & Model Settings (Opens dedicated Settings window) -->
                        <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                                Command="{Binding OpenAISettingsCommand}" ToolTip="AI &amp; Model Settings"/>

                        <!-- Close Pane -->
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                Style="{DynamicResource IconButton}" Width="26" Height="26"
                                Click="Close_Click" ToolTip="Close Copilot (Alt+A)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- ROW 1: TAB CONTENT VIEWS (CHAT / HISTORY)       -->
            <!-- ═══════════════════════════════════════════════ -->

            <!-- ─────────────────────────────────────────────── -->
            <!-- VIEW A: CHAT VIEW                               -->
            <!-- ─────────────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Chat">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Context Bar -->
                    <RowDefinition Height="*"/>    <!-- Messages -->
                    <RowDefinition Height="Auto"/> <!-- Quick Action Chips -->
                    <RowDefinition Height="Auto"/> <!-- Input Omnibar -->
                </Grid.RowDefinitions>

                <!-- Context Bar -->
                <Border Grid.Row="0" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource FolderColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentDirectory}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource TextDimBrush}" FontSize="11.5"/>
                            <TextBlock Text="{Binding DirectoryContextText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#14818CF8" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                            <TextBlock Text="{Binding SelectedFileText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5"
                                       Foreground="{DynamicResource AccentBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chat Messages -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <!-- User Bubble -->
                                    <Border Margin="40,0,0,0" Padding="14,10" CornerRadius="16,16,4,16"
                                            Background="{DynamicResource TabActiveBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            HorizontalAlignment="Right" MaxWidth="380"
                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5"
                                                       LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Timestamp}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5"
                                                       Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Assistant Card -->
                                    <Border Margin="0,0,20,0" Padding="16,14" CornerRadius="16,16,16,4"
                                            Background="{DynamicResource PillBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            HorizontalAlignment="Left" MaxWidth="460">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Card Header: Provider & Latency -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Provider}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
                                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Rich Markdown Renderer (Formatted Headers, Tables, Inlines, KBD, Code Badges) -->
                                            <controls:MarkdownViewer Markdown="{Binding Text}" Margin="0,4,0,6"/>

                                            <!-- Code Block Quick Copy (if code exists) -->
                                            <Border Margin="0,6,0,0" Background="#18000000" CornerRadius="6" Padding="10,6"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding HasCodeSnippet, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Command / Code Snippet" FontFamily="Cascadia Code, Consolas" FontSize="10.5"
                                                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="📋 Copy Code" Padding="8,3" FontSize="10"
                                                            Style="{DynamicResource GlassButton}"
                                                            Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding ExtractedCode}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Arranged Action Buttons Grid (Structured 2-Column Symmetrical Layout) -->
                                            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ButtonLabel}" Margin="3,3,3,3" Height="34"
                                                                FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"
                                                                Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="8" Padding="10,0">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Arranged Next Options Follow-up Chips (Grouped in Structured Card) -->
                                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding HasNextOptions, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                                        <TextBlock Text="💡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Suggested Next Steps" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding NextOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Style="{StaticResource NextOptionChipStyle}"
                                                                        Command="{Binding DataContext.QuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Card Action Strip (Copy Response, Regenerate, Latency, Timestamp) -->
                                            <Border Margin="0,10,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Actions: Copy & Regenerate -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Copy Full Response -->
                                                        <Button ToolTip="Copy response" Height="22" Padding="6,2" Margin="0,0,6,0" Cursor="Hand"
                                                                Background="Transparent" BorderThickness="0"
                                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                                </StackPanel>
                                                        </Button>

                                                        <!-- Regenerate -->
                                                        <Button ToolTip="Regenerate response" Height="22" Padding="6,2" Margin="0,0,6,0" Cursor="Hand"
                                                                Background="Transparent" BorderThickness="0"
                                                                Command="{Binding DataContext.RegenerateLastMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" Retry" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Transient Copied feedback -->
                                                    <TextBlock Grid.Column="1" Text="✓ Copied to clipboard" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5"
                                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}"/>

                                                    <!-- Right: Latency & Timestamp -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LatencyText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5"
                                                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Timestamp}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9"
                                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Quick Prompt Bar -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,5">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📁 Analyze Folder" Style="{DynamicResource GlassButton}" Padding="10,4" Margin="2,0" FontSize="11"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="Analyze this folder"/>
                            <Button Content="🔍 Find Duplicates" Style="{DynamicResource GlassButton}" Padding="10,4" Margin="2,0" FontSize="11"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="Find duplicates in this folder"/>
                            <Button Content="📝 Summarize Selection" Style="{DynamicResource GlassButton}" Padding="10,4" Margin="2,0" FontSize="11"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="Summarize the selected file"/>
                            <Button Content="🧹 Smart Organization" Style="{DynamicResource GlassButton}" Padding="10,4" Margin="2,0" FontSize="11"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="How should I organize this folder?"/>
                            <Button Content="💻 PowerShell Script" Style="{DynamicResource GlassButton}" Padding="10,4" Margin="2,0" FontSize="11"
                                    Command="{Binding QuickPromptCommand}" CommandParameter="Give me a PowerShell script for this folder"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Input Omnibar -->
                <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Context Pill Row -->
                            <RowDefinition Height="Auto"/> <!-- Input + Action Button Row -->
                        </Grid.RowDefinitions>

                        <!-- Context Attachment Pills -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource FolderColorBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding CurrentDirectory}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#14818CF8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0.6"
                                    CornerRadius="5" Padding="7,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding SelectedFileText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Input + Action Button -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Input Box -->
                            <Border Grid.Column="0" Background="{DynamicResource PillBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7" Margin="0,0,8,0">
                                <Grid>
                                    <TextBox x:Name="PromptTextBox"
                                             Text="{Binding PromptInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             KeyDown="PromptTextBox_KeyDown"/>

                                    <TextBlock Text="Ask a question or request a task..."
                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
                                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PromptTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Action Button (Send or Stop Generating) -->
                            <Grid Grid.Column="1" Width="36" Height="36">
                                <!-- Stop Button -->
                                <Button Cursor="Hand" Command="{Binding StopGeneratingCommand}" ToolTip="Stop Generating"
                                        Width="36" Height="36">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="stopBg" Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="stopBg" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Send Button -->
                                <Button Cursor="Hand" Command="{Binding SendMessageCommand}" ToolTip="Send message (Enter)"
                                        Width="36" Height="36">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="sendBg" Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="sendBg" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="sendBg" Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────────────────────────────────────────────── -->
            <!-- VIEW D: HISTORY SESSIONS                        -->
            <!-- ─────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header & Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📜 Chat History" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Review, restore, or export past conversations." FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📥 Export Active (.md)" Style="{DynamicResource GlassButton}" Padding="8,4" Margin="0,0,6,0" FontSize="10.5"
                                Command="{Binding ExportChatCommand}"/>
                        <Button Content="🗑️ Clear All" Style="{DynamicResource GlassButton}" Padding="8,4" FontSize="10.5"
                                Command="{Binding ClearHistoryCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Sessions List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistorySessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FolderPath, StringFormat='Folder: {0}'}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5"
                                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Timestamp}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Resume" Style="{DynamicResource GlassButton}" Padding="10,4" FontSize="10.5"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RestoreSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State Message -->
                <Border Grid.Row="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHistorySessions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📜" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No Archived Chats Yet" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="When you start a new conversation (using the '+' button in the top header), your active chat is automatically saved here so you can review or resume it anytime."
                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Footer back to chat -->
                <Button Grid.Row="2" Content="← Back to Active Chat" Style="{DynamicResource GlassButton}" Padding="12,6"
                        HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11.5"
                        Command="{Binding ToggleHistoryCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
