                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Item 2: Selected App File with Glow -->
                                                    <Border Grid.Column="2" Background="#506366F1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
