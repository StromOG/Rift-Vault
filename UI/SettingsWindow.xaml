                                            </Border>

                                            <!-- Row 4: File Canvas Glass Translucency -->
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🪟" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="File Canvas Glass Translucency" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="Translucency wash over file browsing panes and sidebar cards." FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="21,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                                            <TextBlock x:Name="FileAreaGlassText" Text="25%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <Slider Grid.Row="2" x:Name="FileAreaGlassSlider" Minimum="0.05" Maximum="0.80" Value="0.25" SmallChange="0.05" LargeChange="0.1" ValueChanged="FileAreaGlassSlider_ValueChanged"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Fit Style Selection -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Image Scaling &amp; Display Fit" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="How the background wallpaper scales across your display." FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="WallpaperStretchCombo" Style="{StaticResource ModernComboBox}" Width="190" SelectionChanged="WallpaperStretch_SelectionChanged">
                                                <ComboBoxItem Content="Fill window (UniformToFill)" Tag="UniformToFill" IsSelected="True"/>
                                                <ComboBoxItem Content="Fit inside (Uniform)" Tag="Uniform"/>
                                                <ComboBoxItem Content="Stretch to edges (Fill)" Tag="Fill"/>
                                                <ComboBoxItem Content="Original size (None)" Tag="None"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- UI Density -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Item spacing" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Change row spacing in file lists."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="DensityCombo" SelectionChanged="Density_SelectionChanged">
                                            <ComboBoxItem Content="Compact" Tag="Compact"/>
                                            <ComboBoxItem Content="Normal (Default)" Tag="Comfortable" IsSelected="True"/>
                                            <ComboBoxItem Content="Large" Tag="Spacious"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Animation Speed -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Animation speed" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Control how fast menus and panels animate."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="AnimationSpeedCombo" SelectionChanged="AnimationSpeed_SelectionChanged">
                                            <ComboBoxItem Content="Off (Instant)" Tag="Instant"/>
                                            <ComboBoxItem Content="Fast" Tag="Fast"/>
                                            <ComboBoxItem Content="Normal" Tag="Normal" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Window Backdrop Effect -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Window backdrop effect" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Material composition styling for window framing."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="WindowBackdropCombo" SelectionChanged="WindowBackdrop_SelectionChanged">
                                            <ComboBoxItem Content="Default (Solid)" Tag="Default" IsSelected="True"/>
                                            <ComboBoxItem Content="Mica (Windows 11)" Tag="Mica"/>
                                            <ComboBoxItem Content="Acrylic Blur" Tag="Acrylic"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- ═══════════════════════════════════════════ -->
                                <!-- CARD: WINDOW CORNER CURVATURE & FRAMING    -->
                                <!-- ═══════════════════════════════════════════ -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Window Curvature &amp; Framing" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="Customize window corner rounding across Rift Vault and dialogs. Seamlessly hardware accelerated with Windows 11 DWM."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="190" x:Name="WindowCornersCombo" SelectionChanged="WindowCorners_SelectionChanged" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Extra Curved (24px)" Tag="24"/>
                                                <ComboBoxItem Content="Curved (16px) · Default" Tag="16" IsSelected="True"/>
                                                <ComboBoxItem Content="Subtle Round (8px)" Tag="8"/>
                                                <ComboBoxItem Content="Sharp Square (0px)" Tag="0"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Corner Radius Visual Quick Selector Cards -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 1: 24px Extra Curved -->
                                            <Border x:Name="CornerCard24" Grid.Column="0" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="10,12" Cursor="Hand" MouseLeftButtonDown="CornerCard24_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="36" Height="26" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="#14818CF8" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Extra Curved" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="24 px" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: 16px Curved (Default) -->
                                            <Border x:Name="CornerCard16" Grid.Column="2" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Padding="10,12" Cursor="Hand" MouseLeftButtonDown="CornerCard16_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="36" Height="26" CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="#14818CF8" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Standard Curved" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="16 px (Win 11)" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 3: 8px Subtle -->
                                            <Border x:Name="CornerCard8" Grid.Column="4" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="10,12" Cursor="Hand" MouseLeftButtonDown="CornerCard8_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="36" Height="26" CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" Background="#08FFFFFF" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Subtle Round" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="8 px" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 4: 0px Square -->
                                            <Border x:Name="CornerCard0" Grid.Column="6" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="10,12" Cursor="Hand" MouseLeftButtonDown="CornerCard0_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="36" Height="26" CornerRadius="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" Background="#08FFFFFF" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Sharp Square" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="0 px" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ═══════════════════════════════════════════ -->
                                <!-- CARD: FLUID MOTION & ANIMATION STUDIO       -->
                                <!-- ═══════════════════════════════════════════ -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <!-- Header & Master Toggle -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Fluid Motion &amp; Animation Studio" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#1410B981" VerticalAlignment="Center">
                                                        <TextBlock Text="SMOOTH MOTION ENGINE" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Tailor window opening/closing physics, select animation choreography styles, and customize millisecond timing."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="EnableAnimationsToggle" Click="EnableAnimations_ToggleChanged" VerticalAlignment="Center"/>
