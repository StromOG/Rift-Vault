<Window x:Class="RiftVault.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rift Vault Settings" Height="720" Width="1020"
        MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UIFont}" FontSize="13.5"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Category Nav Button Style -->
        <Style x:Key="CategoryNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UIFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Card Style -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="SettingsRootBorder"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="SettingsScale" ScaleX="1.0" ScaleY="1.0"/>
                <TranslateTransform x:Name="SettingsTranslate" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TOP TITLE BAR                                   -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Settings" FontFamily="{DynamicResource UIFont}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search box in title bar -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Height="32"
                        Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="7" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="SettingsSearchBox" TextChanged="SettingsSearchBox_TextChanged"
                                 Background="Transparent" BorderThickness="0" FontFamily="{DynamicResource UIFont}" FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="30,0,8,0"/>
                        <TextBlock Text="Search settings..." FontFamily="{DynamicResource UIFont}" FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="32,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                             <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Close button -->
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- MAIN SPLIT (Sidebar Navigation + Details)       -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="12,8,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="14"/> <!-- Gap -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Category Navigation Island -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="6,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontFamily="{DynamicResource UIFont}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="12,6,0,8"/>

                            <RadioButton x:Name="NavGeneral" Style="{StaticResource CategoryNavButton}" IsChecked="True" Checked="Category_Checked" Tag="General">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="General" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAppearance" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Appearance">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavFiles" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Files &amp; Folders" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavTools" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Tools">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Terminal &amp; Tools" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavShortcuts" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Shortcuts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Keyboard Shortcuts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="12,8"/>

                            <TextBlock Text="TOOLS &amp; SYSTEM" FontFamily="{DynamicResource UIFont}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="12,4,0,8"/>

                            <RadioButton x:Name="NavAI" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="AI">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Smart Features" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPerf" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Performance">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Performance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPrivacy" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Privacy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Privacy &amp; Security" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAudio" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Audio">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Sounds" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAdvanced" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="Advanced">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="Advanced &amp; Backup" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAbout" Style="{StaticResource CategoryNavButton}" Checked="Category_Checked" Tag="About">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Width="24"/>
                                    <TextBlock Text="About" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Detail Cards Island -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <ScrollViewer x:Name="SettingsContentScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: GENERAL                           -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionGeneral">
                                <TextBlock Text="General" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Control startup folders and basic behavior."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Startup Behavior -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="When Rift Vault opens" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Choose which folder opens when you start the app."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="StartupBehaviorCombo" SelectionChanged="StartupBehavior_SelectionChanged">
                                            <ComboBoxItem Content="Home folder" Tag="Home" IsSelected="True"/>
                                            <ComboBoxItem Content="Reopen last tabs" Tag="LastSession"/>
                                            <ComboBoxItem Content="This PC (Drives)" Tag="ThisPC"/>
                                            <ComboBoxItem Content="Custom folder" Tag="CustomFolder"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Custom Startup Folder -->
                                <Border Style="{StaticResource SettingCard}" x:Name="CustomStartupCard">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="Custom startup folder" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Directory opened on startup when 'Custom folder' is chosen above."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomStartupBox" IsReadOnly="True"
                                                     FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Browse..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                    Style="{DynamicResource GlassButton}" Padding="14,6" Cursor="Hand" Click="BrowseCustomStartup_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Restore Previous Tabs -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Reopen previous tabs" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Automatically open tabs you had open when you closed the app."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="RestoreTabsToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Navigation: Double-Click Blank Area to Go Up -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Double-click empty canvas to go up" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Double-clicking the empty background area navigates up to the parent directory."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="DoubleClickBlankToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Navigation: Middle-Click Folder to Open in New Tab -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Middle-click folder to open in new tab" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Clicking a folder with mouse middle button opens it instantly in a new background tab."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="MiddleClickTabToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- UI: Show Full Path in Title Bar -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show full path in window title bar" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Display the complete absolute folder path in the window header instead of just the folder name."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ShowFullPathToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- UI: Show Status Bar -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show docked status bar" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Display bottom status bar with file count, selected size, and AI status."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ShowStatusBarToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Confirm Before Delete -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ask before deleting" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Show a confirmation popup before deleting files or folders."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ConfirmDeleteToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Single Click to Open -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Single-click to open files" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Open files and folders with one click instead of double-clicking."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="SingleClickToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Auto-Refresh on File Events -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Update folder when files change" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Automatically refresh the list when files are created, renamed, or deleted by other apps."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="AutoRefreshToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: APPEARANCE                        -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                                <TextBlock Text="Appearance" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Change colors, background wallpaper, layout spacing, and animation speed."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- ═══════════════════════════════════════════ -->
                                <!-- CARD 1: THEME HARMONIZATION & DESIGNER PALETTES -->
                                <!-- ═══════════════════════════════════════════ -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Theme Harmony &amp; Visual Grading" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#14818CF8" VerticalAlignment="Center">
                                                        <TextBlock Text="WCAG AAA HIGH CONTRAST" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Curated color grading and surface luminance systems. Every theme is mathematically tuned for ultra-high legibility and eye comfort."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 6 Designer Theme Cards Grid (3 Columns x 2 Rows) -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 0,0: Obsidian Eclipse (Signature Dark Indigo) -->
                                            <Border x:Name="ThemeCardObsidian" Grid.Row="0" Grid.Column="0"
                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                                    CornerRadius="10" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="ThemeObsidian_Click">
                                                <StackPanel>
                                                    <Border Height="18" CornerRadius="9" Background="#090C15" BorderBrush="#1F2740" BorderThickness="1" Margin="0,0,0,10" Padding="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#090C15" CornerRadius="7,0,0,7"/>
                                                            <Border Grid.Column="1" Background="#111626"/>
                                                            <Border Grid.Column="2" Background="#6366F1" CornerRadius="0,7,7,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Obsidian Eclipse" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
