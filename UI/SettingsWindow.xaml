                                                <TextBlock Text="Motion trajectory applied when windows and dialogs open." FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="240" x:Name="WindowEntranceCombo" SelectionChanged="WindowEntrance_SelectionChanged">
                                                <ComboBoxItem Content="🍃 Fluent Spring (Bounce)" Tag="FluentSpring" IsSelected="True"/>
                                                <ComboBoxItem Content="🌊 Smooth Scale &amp; Fade" Tag="SmoothScale"/>
                                                <ComboBoxItem Content="🚀 Cinematic Slide Up" Tag="SlideUp"/>
                                                <ComboBoxItem Content="🔍 Gentle Soft Zoom" Tag="SoftZoom"/>
                                                <ComboBoxItem Content="👁️ Pure Fade Only" Tag="FadeOnly"/>
                                                <ComboBoxItem Content="⚡ Instant (No Animation)" Tag="Instant"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- 2-Column Timing & Physics Customizer Sliders -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Row 0, Col 0: Window Entrance Duration -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Window Entrance Duration" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="WindowDurationText" Text="280 ms" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <Slider x:Name="WindowDurationSlider" Minimum="100" Maximum="800" Value="280" SmallChange="20" LargeChange="50" ValueChanged="WindowDurationSlider_ValueChanged"/>
                                            </StackPanel>

                                            <!-- Row 0, Col 2: Window Exit / Dismiss Duration -->
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Window Close / Exit Duration" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="WindowCloseDurationText" Text="180 ms" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <Slider x:Name="WindowCloseDurationSlider" Minimum="80" Maximum="450" Value="180" SmallChange="10" LargeChange="50" ValueChanged="WindowCloseDurationSlider_ValueChanged"/>
                                            </StackPanel>

                                            <!-- Row 2, Col 0: Easing Function -->
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="Animation Easing Curve" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch" x:Name="EasingFunctionCombo" SelectionChanged="EasingFunction_SelectionChanged">
                                                    <ComboBoxItem Content="Natural Cubic (CubicEase)" Tag="Cubic" IsSelected="True"/>
                                                    <ComboBoxItem Content="Silky Smooth (QuinticEase)" Tag="Quintic"/>
                                                    <ComboBoxItem Content="Spring Bounce (BackEase)" Tag="Back"/>
                                                    <ComboBoxItem Content="Elastic Settle (ElasticEase)" Tag="Elastic"/>
                                                    <ComboBoxItem Content="Snappy Fast (QuadraticEase)" Tag="Quadratic"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Row 2, Col 2: Spring Bounce Amplitude -->
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Spring Bounce Amplitude" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="SpringIntensityText" Text="0.25" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <Slider x:Name="SpringIntensitySlider" Minimum="0.05" Maximum="0.70" Value="0.25" SmallChange="0.05" LargeChange="0.10" ValueChanged="SpringIntensitySlider_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Live Animation Test Box & Trigger -->
                                        <Border Margin="0,4,0,0" Padding="14,12" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- Animation Preview Target Box -->
                                                    <Border x:Name="AnimationPreviewTarget" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Live Motion Physics Test" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="Click the button to test your customized choreography and millisecond timing live." FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="▶ Test Window Animation" Style="{DynamicResource GlassButton}" Padding="18,8" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="TestAnimation_Click" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Toolbar & Action Blocks Customization -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Explorer toolbar &amp; action blocks" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Reorder toolbar tools, drag blocks, and add or remove buttons to customize your layout."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Customize Toolbar..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                Style="{DynamicResource GlassButton}" Padding="16,6" Cursor="Hand" Click="CustomizeToolbar_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: FILES & FOLDERS                   -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionFiles" Visibility="Collapsed">
                                <TextBlock Text="Files &amp; Folders" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose how files and folders look and behave."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Show Hidden Files -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show hidden files and folders" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Show hidden files (like AppData or .git)."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="HiddenFilesToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Show Protected Operating System Files -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show protected operating system files" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Display critical Windows system files and protected components."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ProtectedSystemFilesToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Show File Extensions -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show file extensions (.txt, .png, etc.)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Always show the extension at the end of filenames."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ExtensionsToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Calculate Folder Sizes -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show folder sizes" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Calculate and display folder sizes in the background."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="FolderSizesToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Date Format -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Date format" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Choose how dates are shown in file lists."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="DateFormatCombo" SelectionChanged="DateFormat_SelectionChanged">
                                            <ComboBoxItem Content="Relative (e.g. 2h ago)" Tag="Relative" IsSelected="True"/>
                                            <ComboBoxItem Content="Standard date" Tag="Standard"/>
                                            <ComboBoxItem Content="Year-Month-Day" Tag="ISO"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Preview Pane & Built-in Mini-Editor -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Preview pane &amp; text viewer" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Options for previewing photos, videos, and reading text files."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                                        <!-- Open Preview Pane on Launch -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Show preview pane when starting app" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Open the side preview panel automatically when the app starts."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="PreviewPaneDefaultToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Auto-Play Video -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Play video previews automatically" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Play video and audio files immediately when you select them."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="AutoplayVideoToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Word Wrap in Code Editor -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Wrap lines in text preview" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Wrap long lines so you don't have to scroll horizontally."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="CodeWrapToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: TERMINAL & EXTERNAL TOOLS          -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionTools" Visibility="Collapsed">
                                <TextBlock Text="Terminal &amp; External Tools" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Configure command-line consoles, code editors, and compression tools."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Preferred Terminal Console -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Preferred terminal console" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Console launched when clicking Terminal or pressing action strip button."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="210" x:Name="PreferredTerminalCombo" SelectionChanged="PreferredTerminal_SelectionChanged">
                                                <ComboBoxItem Content="Windows Terminal (wt.exe)" Tag="WindowsTerminal" IsSelected="True"/>
                                                <ComboBoxItem Content="Windows PowerShell" Tag="PowerShell"/>
                                                <ComboBoxItem Content="Command Prompt (cmd.exe)" Tag="Cmd"/>
                                                <ComboBoxItem Content="Git Bash (git-bash.exe)" Tag="GitBash"/>
                                                <ComboBoxItem Content="Custom Executable..." Tag="Custom"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Custom Terminal Executable Path -->
                                        <Grid x:Name="CustomTerminalRow" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomTerminalPathBox" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     TextChanged="CustomTerminalPath_TextChanged"/>
                                            <Button Grid.Column="1" Content="Browse..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                    Style="{DynamicResource GlassButton}" Padding="14,6" Cursor="Hand" Click="BrowseCustomTerminal_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Preferred Code / Text Editor -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Preferred code / text editor" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Application opened when opening files or editing code."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="210" x:Name="PreferredEditorCombo" SelectionChanged="PreferredEditor_SelectionChanged">
                                                <ComboBoxItem Content="Built-in viewer / editor" Tag="BuiltIn" IsSelected="True"/>
                                                <ComboBoxItem Content="Visual Studio Code" Tag="VSCode"/>
                                                <ComboBoxItem Content="Windows Notepad" Tag="Notepad"/>
                                                <ComboBoxItem Content="Notepad++" Tag="NotepadPlusPlus"/>
                                                <ComboBoxItem Content="Custom Executable..." Tag="Custom"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Custom Editor Executable Path -->
                                        <Grid x:Name="CustomEditorRow" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomEditorPathBox" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     TextChanged="CustomEditorPath_TextChanged"/>
                                            <Button Grid.Column="1" Content="Browse..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                    Style="{DynamicResource GlassButton}" Padding="14,6" Cursor="Hand" Click="BrowseCustomEditor_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Archive & Compression Utility -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Archive &amp; Compression Defaults" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Configure format and compression ratio trade-offs for files created in Rift Vault."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Default format" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" x:Name="ArchiveFormatCombo" SelectionChanged="ArchiveFormat_SelectionChanged">
                                                    <ComboBoxItem Content="ZIP Archive (.zip)" Tag="zip" IsSelected="True"/>
                                                    <ComboBoxItem Content="TAR Archive (.tar)" Tag="tar"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Compression speed / ratio" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" x:Name="CompressionLevelCombo" SelectionChanged="CompressionLevel_SelectionChanged">
                                                    <ComboBoxItem Content="Optimal (Balanced size)" Tag="Optimal" IsSelected="True"/>
                                                    <ComboBoxItem Content="Fastest (Quick archive)" Tag="Fastest"/>
                                                    <ComboBoxItem Content="No Compression (Store)" Tag="NoCompression"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: KEYBOARD SHORTCUTS REFERENCE       -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionShortcuts" Visibility="Collapsed">
                                <TextBlock Text="Keyboard Shortcuts" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Reference cheat sheet of keyboard hotkeys for swift navigation."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                <!-- Search Shortcuts Filter -->
                                <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Height="34" Margin="0,0,0,12" Padding="8,0">
                                    <Grid>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBox x:Name="ShortcutSearchBox" Background="Transparent" BorderThickness="0"
                                                 FontFamily="{DynamicResource UIFont}" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="26,0,4,0"
                                                 TextChanged="ShortcutSearchBox_TextChanged"/>
                                        <TextBlock Text="Filter shortcuts (e.g. tab, copy, details, rename)..." FontFamily="{DynamicResource UIFont}" FontSize="12"
                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="28,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ShortcutSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Navigation & Tabs Shortcuts -->
                                <TextBlock Text="NAVIGATION &amp; TABS" FontFamily="{DynamicResource UIFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,8"/>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Navigate to previous directory (Back)" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Alt + Left" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Navigate forward" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Alt + Right" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Navigate up to parent folder" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Alt + Up" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Refresh directory contents" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="F5  /  Ctrl + R" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Open new explorer tab" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + T" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Close current tab" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + W" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Reopen last closed tab" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + T" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- File Operations -->
                                <TextBlock Text="FILE OPERATIONS" FontFamily="{DynamicResource UIFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,8"/>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Create new folder" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + N" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Create new file" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + N" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
