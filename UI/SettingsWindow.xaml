                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Delete" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Permanently delete / shred item" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Shift + Delete" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Item properties &amp; metadata" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Alt + Enter" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Views & Panels -->
                                <TextBlock Text="VIEWS &amp; PANELS" FontFamily="{DynamicResource UIFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,8"/>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Details view mode" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + 6" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Grid icons mode" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + 2" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="List view mode" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + 5" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle dual-pane commander" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + 2" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle side preview pane" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + Shift + P" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle AI copilot assistant" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Alt + A" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle hidden files" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="Ctrl + H" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: AI & LOCAL INTELLIGENCE            -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionAI" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="AI &amp; Local Intelligence" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Style="{StaticResource BadgePill}" Margin="10,2,0,2" Background="#1E34D399" BorderBrush="#34D399">
                                            <TextBlock Text="100% PRIVATE · ZERO-CLOUD RUNTIME" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🚀 Launch Setup Wizard" Style="{DynamicResource GlassButton}" Padding="12,5" FontSize="11"
                                            Click="LaunchSetupWizard_Click" ToolTip="Re-run first-time onboarding wizard"/>
                                </Grid>
                                <TextBlock Text="Configure your preferred intelligence engine. Rift Vault works 100% offline out-of-the-box, with optional bridges for Ollama and Cloud LLMs."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                                <!-- Card 1: Engine Selection -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Primary Intelligence Engine" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Choose how AI analyzes folders, generates scripts, and suggests file actions."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <!-- 4 Engine Options -->
                                        <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚡ Built-In Local Neural Core" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Margin="8,0,0,0" Padding="5,2" CornerRadius="4" Background="#1A34D399">
                                                            <TextBlock Text="DEFAULT · ZERO DOWNLOADS" FontSize="8.5" FontWeight="Bold" Foreground="#34D399"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="100% offline native C# engine. Ultra-fast (&lt;15ms) folder analysis, duplicate detection, and PowerShell generation with absolute privacy."
                                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <RadioButton Grid.Column="1" x:Name="AIProviderBuiltInRadio" GroupName="AIProviderGroup" Tag="BuiltIn" VerticalAlignment="Center"
                                                             Checked="AIProvider_Checked"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="OllamaCardBorder" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🦙 Local Ollama Models" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Margin="8,0,0,0" Padding="5,2" CornerRadius="4" Background="#14818CF8">
                                                            <TextBlock Text="PRIVATE LOCAL LLM" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Connect to Ollama running on localhost:11434. Uses reasoning models like Phi-3, Llama 3.2, or Mistral with zero telemetry."
                                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <RadioButton Grid.Column="1" x:Name="AIProviderOllamaRadio" GroupName="AIProviderGroup" Tag="Ollama" VerticalAlignment="Center"
                                                             Checked="AIProvider_Checked"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="CloudCardBorder" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="☁️ Cloud AI API" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Margin="8,0,0,0" Padding="5,2" CornerRadius="4" Background="#14F59E0B">
                                                            <TextBlock Text="OPTIONAL API KEY" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Connect OpenAI, Groq, or Google Gemini. Requires your personal API key for high-parameter general reasoning."
                                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <RadioButton Grid.Column="1" x:Name="AIProviderCloudRadio" GroupName="AIProviderGroup" Tag="Cloud" VerticalAlignment="Center"
                                                             Checked="AIProvider_Checked"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="📁 Traditional Mode (AI Disabled)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Disables AI copilot and neural background indexing for maximum minimalism."
                                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <RadioButton Grid.Column="1" x:Name="AIProviderDisabledRadio" GroupName="AIProviderGroup" Tag="Disabled" VerticalAlignment="Center"
                                                             Checked="AIProvider_Checked"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Ollama Local Server Bridge -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="🦙 Ollama Local Server Settings" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Style="{StaticResource BadgePill}" Margin="8,0,0,0" Background="#14818CF8">
                                                <TextBlock Text="PORT 11434" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="If Ollama is installed on your PC, start it and test connection below."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Endpoint URL:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="LlmEndpointBox" Grid.Column="1" Text="http://localhost:11434"
                                                     FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,5"
                                                     LostFocus="AIConfig_LostFocus"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Model Identifier:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="LlmModelBox" Grid.Column="1" Text="phi3:mini"
                                                     FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,5" Margin="0,0,8,0"
                                                     LostFocus="AIConfig_LostFocus"/>
                                            <Button Grid.Column="2" Content="🔄 Test Connection" Style="{DynamicResource GlassButton}" Padding="12,5" FontSize="11"
                                                    Click="TestLlmConnection_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Cloud AI API Bridge -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="☁️ Cloud Provider API Configuration" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Optional. Keys are saved securely in your local user app data folder and never shared."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Provider:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CloudProviderCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="CloudProvider_SelectionChanged">
                                                <ComboBoxItem Content="OpenAI (GPT-4o mini / GPT-4o)" Tag="OpenAI" IsSelected="True"/>
                                                <ComboBoxItem Content="Groq (Ultra-fast Llama 3.3)" Tag="Groq"/>
                                                <ComboBoxItem Content="Google Gemini (Gemini 1.5 Flash)" Tag="Gemini"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API Key:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CloudApiKeyBox" Grid.Column="1"
                                                     FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,5"
                                                     LostFocus="AIConfig_LostFocus"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Model Name:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CloudModelBox" Grid.Column="1" Text="gpt-4o-mini"
                                                     FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
                                                     Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                     BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,5"
                                                     LostFocus="AIConfig_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: AI Behavior, Personality & Guardrails -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Behavior, Personality &amp; Guardrails" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Fine-tune how the AI assistant communicates and what file actions it is permitted to take."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Personality Preset:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="AIPersonalityCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="AIPersonality_SelectionChanged">
                                                <ComboBoxItem Content="Balanced (Helpful &amp; Friendly)" Tag="Balanced" IsSelected="True"/>
                                                <ComboBoxItem Content="Technical (Forensics &amp; Deep Metadata)" Tag="Technical"/>
                                                <ComboBoxItem Content="Concise (Bullet Points &amp; Quick Facts)" Tag="Concise"/>
                                                <ComboBoxItem Content="Creative (Tagging &amp; Organization)" Tag="Creative"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Temperature -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Creativity / Temperature:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="AITemperatureText" Grid.Column="1" Text="0.7" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                            <Slider Grid.Row="1" x:Name="AITemperatureSlider" Minimum="0.0" Maximum="1.0" Value="0.7"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,6,0,2"
                                                    ValueChanged="AITemperatureSlider_ValueChanged"/>
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="Precise / Deterministic" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Exploratory / Creative" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Custom Instructions -->
                                        <TextBlock Text="Custom Instructions / System Prompt:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="AICustomPromptBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Padding="8,6"
                                                 Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                 BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"
                                                 LostFocus="AIConfig_LostFocus"/>

                                        <!-- Direct file operations -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Allow direct file modifications" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="When enabled, AI action buttons can delete, move, or rename files without secondary prompts."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="AIAllowFileOpsToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Max files analyzed -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Max Files Analyzed per Query:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="AIMaxFilesCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="AIMaxFiles_SelectionChanged">
                                                <ComboBoxItem Content="50 items (Fastest)" Tag="50"/>
                                                <ComboBoxItem Content="100 items (Recommended)" Tag="100" IsSelected="True"/>
                                                <ComboBoxItem Content="250 items (Deep audit)" Tag="250"/>
                                                <ComboBoxItem Content="500 items (Heavy)" Tag="500"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 5: Smart Background Features -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="🧠 Autonomous Background Features" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Toggle individual background intelligence features running on your PC."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <!-- Smart Shelf Prediction -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Suggested files shelf" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Predicts and highlights files you will likely need next based on active workflows."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="SmartShelfToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Duplicate Brain -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Duplicate file detection brain" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Finds exact duplicates and similar photos even under different filenames."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="DuplicateBrainToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Auto Organizer -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Smart category auto-organizer" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Groups downloads and folders into Documents, Images, Videos, and Code."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="AutoOrganizerToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- File DNA -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="File DNA semantic tags" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Enables searching files by concept, topic, or content keywords."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="FileDNAToggle" Click="Setting_ToggleChanged"/>
                                        </Grid>

                                        <!-- Processing Hardware -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Neural processing hardware" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="DirectML GPU acceleration or CPU execution."
                                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="170" x:Name="ComputeDeviceCombo" SelectionChanged="ComputeDevice_SelectionChanged">
                                                <ComboBoxItem Content="Graphics Card (Fastest)" Tag="DirectML GPU" IsSelected="True"/>
                                                <ComboBoxItem Content="Processor (Low Power)" Tag="CPU Only"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: PERFORMANCE & CACHE               -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionPerformance" Visibility="Collapsed">
                                <TextBlock Text="Performance" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Control memory usage and background loading speed."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Thumbnail Cache Size -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Thumbnail cache size" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Amount of memory saved for loading photo and video previews smoothly."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="ThumbnailCacheCombo" SelectionChanged="ThumbnailCache_SelectionChanged">
                                            <ComboBoxItem Content="256 MB (Saves memory)" Tag="256"/>
                                            <ComboBoxItem Content="512 MB (Recommended)" Tag="512" IsSelected="True"/>
                                            <ComboBoxItem Content="1024 MB (Best performance)" Tag="1024"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Concurrent IO Threads -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Background loading speed" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="How many tasks can load folder contents at the same time."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="IOThreadsCombo" SelectionChanged="IOThreads_SelectionChanged">
                                            <ComboBoxItem Content="4 tasks (Slower disks)" Tag="4"/>
                                            <ComboBoxItem Content="8 tasks (Recommended for SSD)" Tag="8" IsSelected="True"/>
                                            <ComboBoxItem Content="16 tasks (Fast NVMe SSD)" Tag="16"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Memory Trimming on Idle -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Free up memory when minimized" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Releases unused memory back to Windows whenever the window is minimized."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="MemoryTrimToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: PRIVACY & VAULT                   -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionPrivacy" Visibility="Collapsed">
                                <TextBlock Text="Privacy &amp; Security" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Options for secure file deletion and offline privacy."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Zero Cloud Guarantee -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Offline only (No data sent)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Rift Vault works completely offline on your PC. No activity or file information is ever collected or sent to the cloud."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="ZeroCloudToggle" IsChecked="True" IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <!-- Secure Shredding -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Permanent file shredding" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="When securely deleting files, overwrites them with random data so they cannot be recovered."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="160" x:Name="ShreddingCombo" SelectionChanged="Shredding_SelectionChanged">
                                            <ComboBoxItem Content="1 pass (Quick erase)" Tag="1"/>
                                            <ComboBoxItem Content="3 passes (Standard secure)" Tag="3" IsSelected="True"/>
                                            <ComboBoxItem Content="7 passes (Deep secure)" Tag="7"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: AUDIO & FEEDBACK                  -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionAudio" Visibility="Collapsed">
                                <TextBlock Text="Sounds" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Play soft sounds when clicking and managing files."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Enable UI Sounds -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Play sound effects" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Play a subtle click sound when browsing folders, opening tabs, and moving files."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" x:Name="UISoundsToggle" Click="Setting_ToggleChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Sound Volume Slider -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sound volume" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Adjust the loudness of sound effects."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="50" x:Name="VolumeSlider" ValueChanged="VolumeSlider_ValueChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: ADVANCED & BACKUP                  -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionAdvanced" Visibility="Collapsed">
                                <TextBlock Text="Advanced &amp; Backup" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Manage configuration backup, thumbnail cache storage, and system directories."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Export & Import Configuration -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Settings Backup &amp; Restore" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Export all your preferences, themes, and tool paths to a JSON file to transfer between PCs or restore later."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Export Settings (JSON)..." Style="{DynamicResource GlassButton}"
                                                    Padding="14,8" Margin="0,0,10,0" Cursor="Hand" Click="ExportSettings_Click"/>
                                            <Button Content="Import Settings (JSON)..." Style="{DynamicResource GlassButton}"
                                                    Padding="14,8" Cursor="Hand" Click="ImportSettings_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Storage & Cache Maintenance -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Clear Thumbnail Cache" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Purge cached image and video thumbnails from RAM and disk to release memory."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear Cache Now" Style="{DynamicResource GlassButton}"
                                                Padding="14,8" Cursor="Hand" Click="ClearThumbnailCache_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Diagnostic & System Folders -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Application Folders" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Directly access Rift Vault configuration files and diagnostic log files on disk."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open Logs Folder" Style="{DynamicResource GlassButton}"
                                                    Padding="14,8" Margin="0,0,10,0" Cursor="Hand" Click="OpenLogsFolder_Click"/>
                                            <Button Content="Open AppData Config" Style="{DynamicResource GlassButton}"
                                                    Padding="14,8" Cursor="Hand" Click="OpenSettingsFolder_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Factory Reset -->
                                <Border Style="{StaticResource SettingCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Reset All Settings to Factory Defaults" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Reverts all settings, colors, and layout configurations back to original factory defaults."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Reset Defaults" Style="{DynamicResource GlassButton}"
                                                Padding="14,8" Cursor="Hand" Click="ResetDefaults_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════ -->
                            <!-- SECTION: ABOUT & SYSTEM                    -->
                            <!-- ═══════════════════════════════════════════ -->
                            <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                                <TextBlock Text="About" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="App version and system information."
                                           FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Rift Vault File Explorer" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Version 1.0.0 · 64-bit Windows" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Built with .NET 8 and Windows WPF" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                        <TextBlock Text="Hardware acceleration: DirectX 12" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Features: Multi-tab file browser with offline smart tools" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{DynamicResource GlassButton}" Content="Reset All Settings to Defaults"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetDefaults_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
