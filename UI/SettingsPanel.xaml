<UserControl x:Class="RiftVault.UI.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:RiftVault.ViewModels">
    <UserControl.Resources>
        <!-- Section Header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <!-- Setting Row -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Settings" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                            HorizontalAlignment="Right" Style="{DynamicResource IconButton}"
                            Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Close Settings"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
                <StackPanel>

                    <!-- ═══ GENERAL ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;"/>
                        <Run Text="  General"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Startup behavior"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="What to show when the app opens"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.StartupBehavior, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Home"/>
                                    <ComboBoxItem Content="LastSession"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Default view mode"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="How files are displayed in new tabs"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.DefaultViewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Grid"/>
                                    <ComboBoxItem Content="List"/>
                                    <ComboBoxItem Content="Details"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Confirm before delete"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.ConfirmBeforeDelete, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Single-click to open"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.SingleClickOpen, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Date format"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="How dates are shown in file details"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.DateFormat, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Relative"/>
                                    <ComboBoxItem Content="Absolute"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ APPEARANCE ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE790;"/>
                        <Run Text="  Appearance"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Theme" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border x:Name="ThemeObsidian" Width="80" Height="48" CornerRadius="6" Margin="0,0,8,0" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        MouseLeftButtonDown="ThemeObsidian_Click">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D0D12" Offset="0"/>
                                            <GradientStop Color="#1C1C28" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Obsidian" FontSize="10" Foreground="#E8E8F0" 
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Border>
                                <Border x:Name="ThemeSolar" Width="80" Height="48" CornerRadius="6" Margin="0,0,8,0" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        MouseLeftButtonDown="ThemeSolar_Click">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#12100D" Offset="0"/>
                                            <GradientStop Color="#242019" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Solar" FontSize="10" Foreground="#F0E8D8" 
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Border>
                                <Border x:Name="ThemeArctic" Width="80" Height="48" CornerRadius="6" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        MouseLeftButtonDown="ThemeArctic_Click">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EEF6FB" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Arctic" FontSize="10" Foreground="#0C2D48" 
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Animation speed"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.AnimationSpeed, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Reduced"/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Fast"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Icon density"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.IconDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Compact"/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Comfortable"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ FILES & FOLDERS ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B7;"/>
                        <Run Text="  Files &amp; Folders"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Show hidden files"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.ShowHiddenFiles, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Show system files"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.ShowSystemFiles, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Show file extensions"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.ShowFileExtensions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ SMART FEATURES ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9D9;"/>
                        <Run Text="  Smart Features"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Suggested files shelf" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="Shows frequently used files at the top of the window"/>
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.EnableSmartShelf, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Search tags for images" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="Automatically adds search tags to images on your computer"/>
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.EnableFileDNA, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Find duplicate files" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="Highlights identical files that take up extra storage space"/>
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.EnableDuplicateBrain, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Sort files into folders" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="Groups files into clean categories like Documents, Media, or Code"/>
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.EnableAutoOrganizer, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Show tags in file list"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.ShowAITagsInGrid, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Background scan speed"/>
                                    <TextBlock Style="{StaticResource SettingDescription}" Text="Higher speed scans faster but uses more processor power"/>
                                </StackPanel>
                                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="140"
                                          SelectedValue="{Binding DataContext.Settings.AIProcessingPriority, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="High"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ SOUNDS ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;"/>
                        <Run Text="  Sounds"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Enable UI sounds"/>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="{Binding DataContext.Settings.EnableUISounds, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Volume"/>
                                <Slider HorizontalAlignment="Right" Width="160" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{Binding DataContext.Settings.SoundVolume, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ ABOUT ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;"/>
                        <Run Text="  About"/>
                    </TextBlock>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Rift Vault" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Style="{StaticResource SettingDescription}" Text="Version 1.0.0" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource SettingDescription}" Text="A fast and modern Windows file explorer with tabs, smart tools, and privacy protection." 
                                       Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource SettingDescription}" Text=".NET 8  ·  WPF  ·  Windows 10/11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
