<Window x:Class="RiftVault.UI.InvestigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RiftVault.UI.Converters"
        mc:Ignorable="d"
        Title="File Details &amp; Inspector"
        Height="730" Width="940"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Mode Tab Radio Button Style -->
        <Style x:Key="ModeTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting / Inspector Card Style -->
        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="InvestigatorRootBorder"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="InvestigatorScale" ScaleX="0.95" ScaleY="0.95"/>
                <TranslateTransform x:Name="InvestigatorTranslate" Y="10"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Target Identity Banner -->
                <RowDefinition Height="Auto"/> <!-- Mode Nav Bar -->
                <RowDefinition Height="*"/>    <!-- Active Mode Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 1. TOP TITLE BAR                                -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="File Details &amp; Inspector" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="INSPECTOR" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
                    <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                            Style="{DynamicResource IconButton}" Width="32" Height="28" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                            Style="{DynamicResource IconButton}" Width="32" Height="28" Click="Close_Click" ToolTip="Close (Esc)"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 2. TARGET IDENTITY BANNER                       -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Icon/Thumbnail -->
                        <ColumnDefinition Width="*"/>    <!-- Name, Type, Path -->
                        <ColumnDefinition Width="Auto"/> <!-- Quick Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Icon or Thumbnail Preview -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10" Margin="0,0,16,0"
                            Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Large Icon Glyph -->
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource InvBoolToVis}}"/>

                            <!-- Rich Image Thumbnail if available -->
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding IsThumbnailLoaded, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="9" RadiusY="9"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- File & Path Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="{Binding BaseName}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                            <TextBlock Text="{Binding Extension}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="17" FontWeight="Normal"
                                       Foreground="{DynamicResource TextDimBrush}" Margin="2,0,8,0"/>

                            <!-- Badge Pill -->
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5" FontWeight="Bold"
                                           Foreground="#0A0E1A"/>
                            </Border>

                            <TextBlock Text="{Binding TypeDescription}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Path with Copy Button -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TargetPath}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" MaxWidth="580"/>
                            <Button Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                     Style="{DynamicResource IconButton}" Width="22" Height="22" Margin="6,0,0,0"
                                     ToolTip="Copy Full Path" Command="{Binding CopyCommand}" CommandParameter="{Binding TargetPath}"/>
                        </StackPanel>

                        <!-- Size information -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileSizeFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ExactBytesFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick External Actions -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Open in Explorer" Click="OpenInExplorer_Click"
                                Style="{DynamicResource SecondaryButton}" Height="30" Padding="12,0" Margin="0,0,0,6"/>
                        <Button Content="Copy Path" Command="{Binding CopyCommand}" CommandParameter="{Binding TargetPath}"
                                Style="{DynamicResource SecondaryButton}" Height="30" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 3. MODE NAV BAR                                 -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab 1: Properties -->
                    <RadioButton Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Properties}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Properties">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Properties"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: File Safety & Format (for Files) or Folder Safety Scan (for Folders) -->
                    <RadioButton Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Forensics}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Forensics">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="File Safety &amp; Format" Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="Folder Safety Scan" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: Hex View (for Files only) -->
                    <RadioButton Style="{StaticResource ModeTabButton}"
                                 Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Hex}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Hex">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hex View"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 4: File Checksums (for Files) or Folder Checksums (for Folders) -->
                    <RadioButton Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Hashes}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Hashes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="File Checksums" Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="Folder Checksums" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 5: Storage Usage (for Directories only) -->
                    <RadioButton Style="{StaticResource ModeTabButton}"
                                 Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Storage}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Storage">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Storage Usage"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 4. ACTIVE MODE CONTENT                          -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Background="{DynamicResource WindowBackgroundBrush}">

                <!-- ─────────────────────────────────────────── -->
                <!-- MODE 1: PROPERTIES                          -->
                <!-- ─────────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                              Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Properties}">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

                        <!-- Timestamps Card -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="DATES &amp; TIMES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Date Created" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding DateCreatedFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Date Modified" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding DateModifiedFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date Accessed" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding DateAccessedFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage Location Card -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="LOCATION &amp; SIZE" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Folder:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ParentDirectory}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Drive:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RootDrive}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Size on disk:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExactBytesFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Content Metrics Card (Visible for text/code/images/executables/drives) -->
                        <Border Style="{StaticResource InspectorCard}" Visibility="{Binding HasContentMetrics, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="FILE DETAILS" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ContentMetric1Label}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding ContentMetric1Value}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ContentMetric2Label}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding ContentMetric2Value}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding ContentMetric3Label}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding ContentMetric3Value}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Security & Ownership Card -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="PERMISSIONS &amp; OWNER" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Owner:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OwnerName}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Permissions:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PermissionsSummary}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- File Attributes Card -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="FILE ATTRIBUTES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <CheckBox Content="Read-only" IsChecked="{Binding IsReadOnly}" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <CheckBox Content="Hidden" IsChecked="{Binding IsHidden}" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <CheckBox Content="System" IsChecked="{Binding IsSystem}" IsEnabled="False" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <CheckBox Content="Archive" IsChecked="{Binding IsArchive}" IsEnabled="False" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <CheckBox Content="Compressed" IsChecked="{Binding IsCompressed}" IsEnabled="False" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <CheckBox Content="Encrypted" IsChecked="{Binding IsEncrypted}" IsEnabled="False" Margin="0,0,24,8"
                                              FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Save Attributes" Command="{Binding ApplyAttributesCommand}"
                                            Style="{DynamicResource PrimaryButton}" Height="30" Padding="14,0"/>
                                    <TextBlock Text="{Binding AttributesStatusMessage}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─────────────────────────────────────────── -->
                <!-- MODE 2A: FILE FORENSICS & MAGIC (Single File) -->
                <!-- ─────────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                              Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Forensics}">
                    <Grid MaxWidth="860" HorizontalAlignment="Stretch">

                        <!-- ================= FOR FILES ================= -->
                        <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}">

                            <!-- Disguise Warning or Verification Banner -->
                            <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A10B981"/>
                                        <Setter Property="BorderBrush" Value="#3310B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Critical">
                                                <Setter Property="Background" Value="#25EF4444"/>
                                                <Setter Property="BorderBrush" Value="#66EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Warning">
                                                <Setter Property="Background" Value="#25F59E0B"/>
                                                <Setter Property="BorderBrush" Value="#66F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Critical">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                        <Setter Property="Text" Value="&#xE783;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="FILE FORMAT &amp; SAFETY CHECK" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Critical">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DisguiseSeverity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisguiseWarningMessage}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Magic Header Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <TextBlock Text="REAL FILE TYPE" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Real format:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetectedFormatFromMagic}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="First bytes in file:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{Binding MagicHeaderHex}" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="First characters:" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{Binding MagicHeaderAscii}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Shannon Entropy Gauge & Breakdown -->
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="DATA RANDOMNESS &amp; COMPRESSION" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding ShannonEntropy, StringFormat={}{0:F3}}"/><Run Text=" / 8.000"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Visual Entropy Bar -->
                                    <ProgressBar Value="{Binding ShannonEntropy}" Maximum="8.0" Minimum="0.0" Height="8" Margin="0,0,0,10"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PillBackgroundBrush}"/>

                                    <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EntropyAssessment}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Randomness indicates whether data is plain text, compressed, or encrypted. Text files have low randomness, while zip archives and media files have high randomness."
                                                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Byte Distribution Summary -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="Empty Bytes (0x00)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding EntropyNullBytesPercent}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="2,0,2,0">
                                            <StackPanel>
                                                <TextBlock Text="Text Characters" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding EntropyAsciiBytesPercent}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Binary Data" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding EntropyHighBytesPercent}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Printable Strings Extractor (ASCII + UTF-16 Unicode) -->
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="READABLE TEXT INSIDE FILE" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalStringsFoundText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Category Filters -->
                                            <Button Content="All" Command="{Binding SelectStringCategoryCommand}" CommandParameter="All"
                                                    Style="{DynamicResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10.5"/>
                                            <Button Content="URLs" Command="{Binding SelectStringCategoryCommand}" CommandParameter="URL"
                                                    Style="{DynamicResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10.5"/>
                                            <Button Content="Paths" Command="{Binding SelectStringCategoryCommand}" CommandParameter="Path"
                                                    Style="{DynamicResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10.5"/>
                                            <Button Content="Registry" Command="{Binding SelectStringCategoryCommand}" CommandParameter="Registry"
                                                    Style="{DynamicResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,8,0" FontSize="10.5"/>

                                            <!-- Filter Search Box -->
                                            <Border Width="180" Height="26" Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                                <Grid>
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBox Text="{Binding StringFilterQuery, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="24,0,6,0"/>
                                                </Grid>
                                            </Border>

                                            <Button Content="Copy Text" Command="{Binding CopyAllStringsCommand}"
                                                    Style="{DynamicResource SecondaryButton}" Height="26" Padding="10,0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" Height="200">
                                        <ListBox ItemsSource="{Binding ExtractedStringItems}" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding CategoryColorHex}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding EncodingType}" FontFamily="Consolas" FontSize="10"
                                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= FOR DIRECTORIES: FOLDER AUDIT ================= -->
                        <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">

                            <!-- Directory Security & Disguise Audit Banner -->
                            <Border CornerRadius="10" Padding="16,14" Margin="0,0,0,14" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A10B981"/>
                                        <Setter Property="BorderBrush" Value="#3310B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSuspiciousFiles}" Value="True">
                                                <Setter Property="Background" Value="#25EF4444"/>
                                                <Setter Property="BorderBrush" Value="#66EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                               VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSuspiciousFiles}" Value="True">
                                                        <Setter Property="Text" Value="&#xE783;"/>
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="FOLDER SAFETY SCAN" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding FolderAuditStatusColor}"/>
                                        <TextBlock Text="{Binding FolderAuditStatus}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Folder Security Metrics Cards -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource InspectorCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Files Scanned" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding TotalSubFiles, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource InspectorCard}" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="Files to Review" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding DisguisedFilesCount, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                                   Foreground="{Binding FolderAuditStatusColor}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource InspectorCard}" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="Hidden Files" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding HiddenFilesCount, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource InspectorCard}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Folder Depth" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding DeepestNestingLevel, StringFormat={}Level {0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Flagged Suspicious Files List (if any) -->
                            <Border Style="{StaticResource InspectorCard}" Visibility="{Binding HasSuspiciousFiles, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="FILES REQUIRING REVIEW" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                               Foreground="#EF4444" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding SuspiciousFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                                                        BorderBrush="#66EF4444" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                                   Foreground="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Reason}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                                       Foreground="{Binding ColorHex}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                                        <Button Grid.Column="3" Content="Inspect" Command="{Binding DataContext.InspectFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Path}" Style="{DynamicResource PrimaryButton}" Height="26" Padding="10,0" FontSize="10.5"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                                <!-- Clean Directory Confirmation (if no suspicious files) -->
                                <Border Style="{StaticResource InspectorCard}" Visibility="{Binding HasSuspiciousFiles, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="SCAN COMPLETE — NO ISSUES FOUND" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                        <TextBlock Text="All files in this folder were scanned. No disguised extensions, double extensions, or hidden code were found."
                                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                <!-- ─────────────────────────────────────────── -->
                <!-- MODE 3: HEX DUMP (Single File Only)         -->
                <!-- ─────────────────────────────────────────── -->
                <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Hex}" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Pagination Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Hex Table -->
                    </Grid.RowDefinitions>

                    <!-- Hex Pagination & Search Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource InspectorCard}" Margin="0,0,0,10" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HEX BYTES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding HexPageStatus}" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Jump & Search in Middle -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="100" Height="26" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Margin="0,0,4,0">
                                    <TextBox Text="{Binding JumpToOffsetInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Enter position (e.g. 0x100) or page (e.g. p2)"/>
                                </Border>
                                <Button Content="Go to" Command="{Binding JumpToHexOffsetCommand}"
                                        Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" FontSize="10.5" Margin="0,0,10,0"/>

                                <Border Width="120" Height="26" Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Margin="0,0,4,0">
                                    <TextBox Text="{Binding HexSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Search text or bytes"/>
                                </Border>
                                <Button Content="Search" Command="{Binding SearchHexCommand}"
                                        Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" FontSize="10.5"/>
                            </StackPanel>

                            <!-- Navigation buttons & Copy -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding FirstHexPageCommand}" Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,4,0" ToolTip="First Page">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Command="{Binding PrevHexPageCommand}" Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,4,0" ToolTip="Previous Page">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Command="{Binding NextHexPageCommand}" Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,4,0" ToolTip="Next Page">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Command="{Binding LastHexPageCommand}" Style="{DynamicResource SecondaryButton}" Height="26" Padding="8,0" Margin="0,0,6,0" ToolTip="Last Page">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Content="Copy Page" Command="{Binding CopyHexPageCommand}" Style="{DynamicResource SecondaryButton}" Height="26" Padding="10,0" FontSize="10.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Monospace Hex & ASCII View -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/> <!-- Column headers -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,0" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="380"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="POSITION" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="TEXT" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HexLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" CornerRadius="4" Padding="6,2" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="380"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Offset}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding HexBytes}" FontFamily="Consolas" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Ascii}" FontFamily="Consolas" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─────────────────────────────────────────── -->
                <!-- MODE 4: HASHES & INTEGRITY                  -->
                <!-- ─────────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                              Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Hashes}">
                    <Grid MaxWidth="860" HorizontalAlignment="Stretch">

                        <!-- FOR FILES: INDIVIDUAL HASHES -->
                        <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}">

                            <!-- Real-Time Hash Matcher Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <TextBlock Text="VERIFY CHECKSUM" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Paste an expected checksum below to compare it with this file and check if it has been modified."
                                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,10"/>

                                    <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Height="38">
                                        <Grid>
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBox Text="{Binding CompareHashInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="34,0,10,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Match indicator -->
                                    <TextBlock Text="{Binding HashMatchStatus}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="Bold"
                                               Margin="0,8,0,0" Visibility="{Binding HashMatchStatus, Converter={StaticResource NullToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                 <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HashMatchColorHex}" Value="#F87171">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- MD5 Hash Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MD5" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Md5Hash}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Command="{Binding CopyCommand}" CommandParameter="{Binding Md5Hash}"
                                            Style="{DynamicResource SecondaryButton}" Height="28" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- SHA-1 Hash Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SHA-1" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sha1Hash}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Command="{Binding CopyCommand}" CommandParameter="{Binding Sha1Hash}"
                                            Style="{DynamicResource SecondaryButton}" Height="28" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- SHA-256 Hash Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SHA-256" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sha256Hash}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="2" Command="{Binding CopyCommand}" CommandParameter="{Binding Sha256Hash}"
                                            Style="{DynamicResource SecondaryButton}" Height="28" Padding="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- SHA-512 Hash Card -->
                            <Border Style="{StaticResource InspectorCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SHA-512" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sha512Hash}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Command="{Binding CopyCommand}" CommandParameter="{Binding Sha512Hash}"
                                            Style="{DynamicResource SecondaryButton}" Height="28" Padding="10,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- One-Click Export File Summary Button -->
                            <Button Content="Copy File Summary Report" Command="{Binding CopyForensicReportCommand}"
                                    Style="{DynamicResource PrimaryButton}" Height="34" Padding="16,0" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- FOR DIRECTORIES: INTEGRITY MANIFEST -->
                        <StackPanel Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="FOLDER CHECKSUM LIST" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding ManifestStatusText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Create Checksum List" Command="{Binding GenerateManifestCommand}"
                                                    Style="{DynamicResource PrimaryButton}" Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="Copy Checksums" Command="{Binding CopyManifestCommand}"
                                                    Style="{DynamicResource SecondaryButton}" Height="28" Padding="12,0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Manifest Files List -->
                                    <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" Height="360">
                                        <ListBox ItemsSource="{Binding ManifestFiles}" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" Padding="8,4" Margin="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Sha256}" FontFamily="Consolas" FontSize="11"
                                                                       Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ─────────────────────────────────────────── -->
                <!-- MODE 5: FOLDER TREE STORAGE INVESTIGATION   -->
                <!-- ─────────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                              Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Storage}">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

                        <!-- Overview Summary Stat Cards -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource InspectorCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total Files" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding TotalSubFiles, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource InspectorCard}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Subfolders" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding TotalSubFolders, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource InspectorCard}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Total Size" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding TotalDirectorySizeFormatted}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource InspectorCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Empty Folders" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding EmptyDirectoriesCount, StringFormat={}{0:N0}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Extension Storage Breakdown -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="SPACE USED BY FILE TYPE" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding ExtensionDistribution}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Extension}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileCount, StringFormat={}{0:N0} files}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5"
                                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="2" Value="{Binding Percentage}" Maximum="100" Height="6"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PillBackgroundBrush}"
                                                             VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11"
                                                           Foreground="{DynamicResource TextDimBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Top 15 Largest Space Consumers -->
                        <Border Style="{StaticResource InspectorCard}">
                            <StackPanel>
                                <TextBlock Text="LARGEST FILES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding LargestFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PillBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                                    <Button Grid.Column="3" Content="Inspect" Command="{Binding DataContext.InspectFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Path}" Style="{DynamicResource SecondaryButton}" Height="24" Padding="8,0" FontSize="10.5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
