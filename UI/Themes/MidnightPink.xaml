<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Nordic Twilight — Deep Arctic Navy & Ice Cyan Theme      -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Base Canvas & Layered Luminance -->
    <Color x:Key="BackgroundColor">#0A0E15</Color>
    <Color x:Key="SurfaceColor">#131B27</Color>
    <Color x:Key="SurfaceRaisedColor">#192333</Color>

    <!-- Arctic Ice Cyan Accent -->
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="AccentAltColor">#7DD3FC</Color>

    <!-- Clean Arctic Silver High-Contrast Typography -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextDimColor">#94A3B8</Color>

    <!-- Semantic Status -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F87171</Color>

    <!-- Micro-Interactions & Borders -->
    <Color x:Key="BorderColor">#202D3F</Color>
    <Color x:Key="SelectionColor">#16324A</Color>
    <Color x:Key="HoverColor">#182436</Color>

    <!-- ─── Core Solid Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <!-- ─── Subtle Backdrop Atmosphere Gradient ────────────── -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#080B11" Offset="0.0"/>
        <GradientStop Color="#101723" Offset="0.5"/>
        <GradientStop Color="#090D14" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ─── Floating Island & Card Brushes ─────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#131B27"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#202D3F"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#192333"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#1A273A"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#172130"/>
    <SolidColorBrush x:Key="PillBorderBrush" Color="#28394E"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#212F44"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#38BDF8"/>

    <!-- ─── Layered Structural Depth & Surface Hierarchy ───── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D121B"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1B2636"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#101622"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#1B2636"/>
    <SolidColorBrush x:Key="FileAreaBackgroundBrush" Color="#141C28"/>
    <SolidColorBrush x:Key="FileAreaBorderBrush" Color="#202D3F"/>
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#172130"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#28394E"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0D121B"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1B2636"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1B2636"/>

    <!-- ─── Harmonized Spectral Icon Palette ────────────────── -->
    <SolidColorBrush x:Key="FolderColorBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="CodeColorBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="ImageColorBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AudioColorBrush" Color="#C084FC"/>
    <SolidColorBrush x:Key="VideoColorBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="DocColorBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ArchiveColorBrush" Color="#67E8F9"/>
    <SolidColorBrush x:Key="ExecColorBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="VaultColorBrush" Color="#0284C7"/>

</ResourceDictionary>
