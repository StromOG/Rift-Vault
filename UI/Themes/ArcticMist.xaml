<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Tokyo Cyber — Midnight Tokyo Synthwave / Neon Cyan Theme -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Base Canvas & Layered Luminance -->
    <Color x:Key="BackgroundColor">#0B0E17</Color>
    <Color x:Key="SurfaceColor">#141A2B</Color>
    <Color x:Key="SurfaceRaisedColor">#1A2238</Color>

    <!-- Electric Neon Cyan Accent -->
    <Color x:Key="AccentColor">#06B6D4</Color>
    <Color x:Key="AccentAltColor">#38BDF8</Color>

    <!-- Crisp High-Contrast Typography Hierarchy -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#93C5FD</Color>
    <Color x:Key="TextDimColor">#60A5FA</Color>

    <!-- Semantic Status -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F43F5E</Color>

    <!-- Micro-Interactions & Borders -->
    <Color x:Key="BorderColor">#202A45</Color>
    <Color x:Key="SelectionColor">#1A3352</Color>
    <Color x:Key="HoverColor">#18233C</Color>

    <!-- ─── Core Solid Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <!-- ─── Subtle Backdrop Atmosphere Gradient ────────────── -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090B13" Offset="0.0"/>
        <GradientStop Color="#121727" Offset="0.5"/>
        <GradientStop Color="#0C0F1A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ─── Floating Island & Card Brushes ─────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#141A2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#202A45"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A2238"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#1C263E"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#182035"/>
    <SolidColorBrush x:Key="PillBorderBrush" Color="#253255"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#202A45"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#06B6D4"/>

    <!-- ─── Layered Structural Depth & Surface Hierarchy ───── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D111D"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1B233A"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#101524"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#1B233A"/>
    <SolidColorBrush x:Key="FileAreaBackgroundBrush" Color="#13192A"/>
    <SolidColorBrush x:Key="FileAreaBorderBrush" Color="#202A45"/>
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#182035"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#253255"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0D111D"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1B233A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1B233A"/>

    <!-- ─── Harmonized Spectral Icon Palette ────────────────── -->
    <SolidColorBrush x:Key="FolderColorBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="CodeColorBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="ImageColorBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AudioColorBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="VideoColorBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="DocColorBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ArchiveColorBrush" Color="#818CF8"/>
    <SolidColorBrush x:Key="ExecColorBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="VaultColorBrush" Color="#06B6D4"/>

</ResourceDictionary>
