<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Fluent Dark — Official Files App / WinUI 3 Dark Palette -->
    <!-- Mica Layered Dark Surfaces, Elevated Slate Canvas       -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Base Canvas & Layered Luminance -->
    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#282828</Color>
    <Color x:Key="SurfaceRaisedColor">#2F2F2F</Color>

    <!-- Windows 11 Fluent Sky Blue Accent -->
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <Color x:Key="AccentAltColor">#0098FF</Color>

    <!-- Crisp High-Contrast Typography Hierarchy -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#D0D0D0</Color>
    <Color x:Key="TextDimColor">#9E9E9E</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="SuccessColor">#6CCB5F</Color>
    <Color x:Key="WarningColor">#FCE100</Color>
    <Color x:Key="ErrorColor">#FF99A4</Color>

    <!-- Micro-Interactions & Border Strokes -->
    <Color x:Key="BorderColor">#383838</Color>
    <Color x:Key="SelectionColor">#1B3A57</Color>
    <Color x:Key="HoverColor">#2E2E2E</Color>

    <!-- ─── Core Solid Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <!-- ─── Subtle Backdrop Atmosphere Gradient (Mica Fill) ── -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#242424" Offset="0.0"/>
        <GradientStop Color="#202020" Offset="0.5"/>
        <GradientStop Color="#1C1C1C" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ─── Floating Island & Card Brushes ─────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#282828"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="PillBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#353535"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#4CC2FF"/>

    <!-- ─── Layered Structural Depth & Surface Hierarchy ───── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FileAreaBackgroundBrush" Color="#272727"/>
    <SolidColorBrush x:Key="FileAreaBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#333333"/>

    <!-- ─── Harmonized Spectral Icon Palette (Windows 11 Fluent) -->
    <SolidColorBrush x:Key="FolderColorBrush" Color="#F0BA46"/>
    <SolidColorBrush x:Key="CodeColorBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="ImageColorBrush" Color="#B197FC"/>
    <SolidColorBrush x:Key="AudioColorBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="VideoColorBrush" Color="#FF6B81"/>
    <SolidColorBrush x:Key="DocColorBrush" Color="#4EBE82"/>
    <SolidColorBrush x:Key="ArchiveColorBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="ExecColorBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="VaultColorBrush" Color="#4CC2FF"/>

</ResourceDictionary>
