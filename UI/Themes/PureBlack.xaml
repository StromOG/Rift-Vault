<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Pure Black — Minimalist Pitch Black OLED Dark Theme     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Base Canvas & Layered Luminance -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="SurfaceColor">#0C0D11</Color>
    <Color x:Key="SurfaceRaisedColor">#151720</Color>

    <!-- Electric Sapphire Blue Minimalist Accent -->
    <Color x:Key="AccentColor">#60A5FA</Color>
    <Color x:Key="AccentAltColor">#93C5FD</Color>

    <!-- Pure High-Contrast Monochromatic Typography -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#E2E8F0</Color>
    <Color x:Key="TextDimColor">#94A3B8</Color>

    <!-- Semantic Status -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F87171</Color>

    <!-- Micro-Interactions & Borders -->
    <Color x:Key="BorderColor">#222530</Color>
    <Color x:Key="SelectionColor">#132644</Color>
    <Color x:Key="HoverColor">#161720</Color>

    <!-- ─── Core Solid Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <!-- ─── Subtle Backdrop Atmosphere Gradient ────────────── -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000000" Offset="0.0"/>
        <GradientStop Color="#06070A" Offset="0.5"/>
        <GradientStop Color="#000000" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ─── Floating Island & Card Brushes ─────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0C0D11"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#222530"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#151720"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#161E30"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#11131A"/>
    <SolidColorBrush x:Key="PillBorderBrush" Color="#282C3C"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#1E212D"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#60A5FA"/>

    <!-- ─── Layered Structural Depth & Surface Hierarchy ───── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#040406"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1C1E26"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#08080C"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#1C1E26"/>
    <SolidColorBrush x:Key="FileAreaBackgroundBrush" Color="#0A0B0E"/>
    <SolidColorBrush x:Key="FileAreaBorderBrush" Color="#222530"/>
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#11131A"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#282C3C"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#040406"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#1C1E26"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1C1E26"/>

    <!-- ─── Harmonized Spectral Icon Palette ────────────────── -->
    <SolidColorBrush x:Key="FolderColorBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="CodeColorBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ImageColorBrush" Color="#C084FC"/>
    <SolidColorBrush x:Key="AudioColorBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="VideoColorBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DocColorBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ArchiveColorBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="ExecColorBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="VaultColorBrush" Color="#2563EB"/>

</ResourceDictionary>
