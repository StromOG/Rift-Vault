<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Solar Fusion — Warm Amber Gold & Obsidian Bronze Theme   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Base Canvas & Layered Luminance -->
    <Color x:Key="BackgroundColor">#0E0B07</Color>
    <Color x:Key="SurfaceColor">#19130B</Color>
    <Color x:Key="SurfaceRaisedColor">#241B0E</Color>

    <!-- Vibrant Solar Gold Accent -->
    <Color x:Key="AccentColor">#F59E0B</Color>
    <Color x:Key="AccentAltColor">#FBBF24</Color>

    <!-- Warm Cream Ivory High-Contrast Typography -->
    <Color x:Key="TextPrimaryColor">#FFFBEB</Color>
    <Color x:Key="TextSecondaryColor">#FDE68A</Color>
    <Color x:Key="TextDimColor">#FCD34D</Color>

    <!-- Semantic Status -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#F87171</Color>

    <!-- Micro-Interactions & Borders -->
    <Color x:Key="BorderColor">#382915</Color>
    <Color x:Key="SelectionColor">#3D280B</Color>
    <Color x:Key="HoverColor">#281D10</Color>

    <!-- ─── Core Solid Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <!-- ─── Subtle Backdrop Atmosphere Gradient ────────────── -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0805" Offset="0.0"/>
        <GradientStop Color="#17120B" Offset="0.5"/>
        <GradientStop Color="#0D0A06" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ─── Floating Island & Card Brushes ─────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#19130B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#382915"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#241B0E"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#2A2012"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#20180D"/>
    <SolidColorBrush x:Key="PillBorderBrush" Color="#3F2F19"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#2D2112"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#F59E0B"/>

    <!-- ─── Layered Structural Depth & Surface Hierarchy ───── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#100D08"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#291F11"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#141009"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#291F11"/>
    <SolidColorBrush x:Key="FileAreaBackgroundBrush" Color="#18130B"/>
    <SolidColorBrush x:Key="FileAreaBorderBrush" Color="#382915"/>
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#20180D"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#3F2F19"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#100D08"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#291F11"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#291F11"/>

    <!-- ─── Harmonized Spectral Icon Palette ────────────────── -->
    <SolidColorBrush x:Key="FolderColorBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="CodeColorBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ImageColorBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="AudioColorBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="VideoColorBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="DocColorBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ArchiveColorBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ExecColorBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="VaultColorBrush" Color="#B45309"/>

</ResourceDictionary>
