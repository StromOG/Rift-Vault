<Window x:Class="RiftVault.UI.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rift Vault - Setup Wizard" Height="580" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="FirstRunRootBorder"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="Auto"/> <!-- Stepper Bar -->
                <RowDefinition Height="*"/>    <!-- Content Container -->
                <RowDefinition Height="Auto"/> <!-- Action / Nav Bar -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 1. TITLE BAR                                    -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,12" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Rift Vault Setup" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StepSubtitleHeader" Text="Step 1 of 3 · Welcome &amp; Setup" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PillBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,12,0">
                            <TextBlock Text="v2.4 Native" FontSize="11" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                Style="{DynamicResource IconButton}" Width="28" Height="28" Click="Close_Click" ToolTip="Close setup"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 2. MINIMAL STEPPER BAR                          -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Node -->
                    <Border x:Name="StepNode1" Grid.Column="0" CornerRadius="14" Padding="14,5" BorderThickness="1"
                            Background="{DynamicResource TabActiveBrush}" BorderBrush="{DynamicResource AccentBrush}" Cursor="Hand" MouseDown="StepNode_Click" Tag="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge1" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                                <TextBlock x:Name="StepBadgeText1" Text="1" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel1" Text="Welcome &amp; Setup" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Height="1.5" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>

                    <!-- Step 2 Node -->
                    <Border x:Name="StepNode2" Grid.Column="2" CornerRadius="14" Padding="14,5" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" MouseDown="StepNode_Click" Tag="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge2" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource PillBackgroundBrush}" Margin="0,0,7,0">
                                <TextBlock x:Name="StepBadgeText2" Text="2" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel2" Text="Appearance" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Height="1.5" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>

                    <!-- Step 3 Node -->
                    <Border x:Name="StepNode3" Grid.Column="4" CornerRadius="14" Padding="14,5" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand" MouseDown="StepNode_Click" Tag="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge3" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource PillBackgroundBrush}" Margin="0,0,7,0">
                                <TextBlock x:Name="StepBadgeText3" Text="3" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel3" Text="Ready" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 3. STEP PAGES CONTENT                           -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="32,20">

                <!-- ─── STEP 1: WELCOME & SETUP ──────────────── -->
                <Grid x:Name="Step1Container" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Welcome to Rift Vault" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="A modern, high-performance file manager with fluid navigation and customizable aesthetics."
                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Destination Card -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="INSTALLATION DESTINATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathText" FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                                         Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse..." Style="{DynamicResource GlassButton}" Click="BrowseInstallPath_Click" Padding="14,8" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- System Integration Toggles -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="SYSTEM INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12"/>

                            <!-- Toggle 1: Desktop Shortcut -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Create Desktop Shortcut" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Quickly launch Rift Vault directly from your desktop." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CheckDesktopShortcut" Grid.Column="1" Style="{DynamicResource ToggleSwitch}" IsChecked="True"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                            <!-- Toggle 2: Explorer Context Menu -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows Explorer Right-Click Menu" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Adds 'Open in Rift Vault' when right-clicking folders or drives." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CheckContextMenu" Grid.Column="1" Style="{DynamicResource ToggleSwitch}" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── STEP 2: APPEARANCE & THEMES ──────────── -->
                <Grid x:Name="Step2Container" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Choose Your Aesthetic" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Pick a curated color theme. You can customize colors and wallpaper anytime in Settings."
                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 4 Minimal Theme Cards (2x2 Grid) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Sandstorm Peach (Default) -->
                        <Border x:Name="CardTheme_SandstormPeach" Grid.Row="0" Grid.Column="0"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                CornerRadius="10" Padding="14" Margin="0,0,8,8" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="SandstormPeach">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Color Preview Swatches -->
                                <Border Grid.Row="0" Height="22" CornerRadius="5" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FAF5EE"/>
                                        <Border Grid.Column="1" Background="#FFFFFF"/>
                                        <Border Grid.Column="2" Background="#E07A5F"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Sandstorm Peach" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Background="#25E07A5F" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DEFAULT" FontSize="9.5" FontWeight="Bold" Foreground="#E07A5F"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Bright, warm desert sand with rich terracotta peach and high-contrast espresso text."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card 2: Obsidian Aurora -->
                        <Border x:Name="CardTheme_ObsidianAurora" Grid.Row="0" Grid.Column="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="14" Margin="8,0,0,8" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="ObsidianAurora">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="22" CornerRadius="5" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0A0D14"/>
                                        <Border Grid.Column="1" Background="#121624"/>
                                        <Border Grid.Column="2" Background="#818CF8"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Obsidian Aurora" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="2" Text="Deep obsidian space dark with cosmic violet and electric indigo glow."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card 3: Tokyo Cyber -->
                        <Border x:Name="CardTheme_ArcticMist" Grid.Row="1" Grid.Column="0"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="14" Margin="0,8,8,0" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="ArcticMist">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="22" CornerRadius="5" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0B0E17"/>
                                        <Border Grid.Column="1" Background="#141A2B"/>
                                        <Border Grid.Column="2" Background="#06B6D4"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Tokyo Cyber" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="2" Text="Midnight cyber blues with electric neon cyan accents."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Card 4: Pure Black OLED -->
                        <Border x:Name="CardTheme_PureBlack" Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="14" Margin="8,8,0,0" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="PureBlack">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="22" CornerRadius="5" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#000000"/>
                                        <Border Grid.Column="1" Background="#0D0D0D"/>
                                        <Border Grid.Column="2" Background="#10B981"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="Pure Black OLED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="2" Text="True pure black surfaces for battery efficiency and emerald contrast."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Window Curvature Minimal Option -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Window Geometry" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Choose between modern Windows 11 curves or crisp rectangular edges." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCornerCurved" Content="Fluent Curves (16px)" Style="{DynamicResource GlassButton}" Click="CornerOption_Click" Tag="16" Padding="12,6" Margin="0,0,6,0"/>
                                <Button x:Name="BtnCornerSharp" Content="Crisp Sharp (0px)" Style="{DynamicResource GlassButton}" Click="CornerOption_Click" Tag="0" Padding="12,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─── STEP 3: READY TO LAUNCH ──────────────── -->
                <Grid x:Name="Step3Container" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-20,0,0">
                        <!-- Glowing Celebration Icon -->
                        <Border Width="72" Height="72" CornerRadius="36" Background="#22E07A5F" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="You're All Set!" FontFamily="Segoe UI Variable, Segoe UI" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rift Vault is personalized and ready to supercharge your file workflow."
                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,24"/>

                        <!-- Minimal Recap Card -->
                        <Border Width="500" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,28">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Active Theme:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock x:Name="RecapThemeText" Text="Sandstorm Peach (Default)" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Install Directory:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock x:Name="RecapPathText" Text="%LocalAppData%\Programs\RiftVault" FontSize="11.5" FontFamily="{DynamicResource MonoFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock Text="Integrations:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock x:Name="RecapIntegrationsText" Text="Desktop Shortcut · Context Menu" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Large Launch Button -->
                        <Button x:Name="BtnFinish" Style="{DynamicResource AccentButton}" Content="Launch Rift Vault →"
                                FontSize="14" FontWeight="Bold" Padding="32,12" HorizontalAlignment="Center" Click="Finish_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 4. ACTION BAR (BOTTOM NAVIGATION)               -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Button x:Name="BtnBack" Content="← Back" Style="{DynamicResource GlassButton}"
                            HorizontalAlignment="Left" Padding="18,8" Click="PrevStep_Click" IsEnabled="False"/>

                    <Button x:Name="BtnNext" Content="Continue →" Style="{DynamicResource AccentButton}"
                            HorizontalAlignment="Right" Padding="22,8" Click="NextStep_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
